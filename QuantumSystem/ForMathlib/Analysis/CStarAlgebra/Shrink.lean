/-!
# Small `⋆`-subalgebras and the C⋆-algebra structure on `Shrink`

The `⋆`-subalgebra generated by a small set `s` of a `⋆`-algebra over a small ring is small
(`NonUnitalStarAlgebra.small_adjoin`): it is the union of the sets obtained from `s ∪ {0}` by
finitely many rounds of sums, products, scalar multiples and adjoints, each small. The closure of a
small set of a Hausdorff Fréchet–Urysohn space, in particular of a metric space, is small
(`small_closure`), each of its points being the limit of a sequence in the set. So a small set of
a topological `⋆`-algebra with these two properties lies in a small closed `⋆`-subalgebra
(`NonUnitalStarSubalgebra.exists_subset_isClosed_small`): the closure of the `⋆`-subalgebra it generates.
In particular finitely many elements of a C⋆-algebra in any universe lie in a closed
`⋆`-subalgebra that is small in `Type`.

A C⋆-algebra `A` that is small in a universe `v` has a copy in `Type v`: `Shrink.{v} A` carries the
C⋆-algebra structure transferred along `equivShrink A`, for which the transfer is a
`⋆`-isomorphism (`Shrink.starAlgEquiv`). Mathlib transfers the ring, module and normed space
structures; this file adds the star structure, the submultiplicativity of the norm, completeness,
the C⋆-identity and the compatibility of the scalar action with the product and the star, each for
the structure of `A` that it transfers.

## Main definitions

* `Shrink.instNonUnitalCStarAlgebra` — the C⋆-algebra structure on `Shrink.{v} A`.
* `Shrink.starAlgEquiv R A` — the `⋆`-isomorphism `Shrink.{v} A ≃⋆ₐ[R] A`.

## Main results

* `small_closure` — the closure of a small set of a Hausdorff Fréchet–Urysohn space is small.
* `NonUnitalStarAlgebra.small_adjoin` — the `⋆`-subalgebra generated by a small set over a small
  ring is small.
* `NonUnitalStarSubalgebra.exists_subset_isClosed_small` — a small set of a topological `⋆`-algebra lies in
  a small closed `⋆`-subalgebra.

These are general facts and are candidates for upstreaming to Mathlib.
-/

@[expose] public section

universe u v

open Set Filter Topology

/-! ### Small sets of a topological space -/

/-- **The closure of a small set of a Hausdorff Fréchet–Urysohn space is small**: each of its points
is the limit of a sequence in the set. Metric spaces are such spaces. -/
theorem small_closure {X : Type*} [TopologicalSpace X] [FrechetUrysohnSpace X] [T2Space X]
    (s : Set X) [Small.{u} s] : Small.{u} (closure s) := by
  rcases isEmpty_or_nonempty X with hX | hX
  · have : IsEmpty (closure s) := ⟨fun x => hX.elim x.1⟩
    exact Countable.toSmall _
  · let f : (ℕ → s) → X := fun w => limUnder atTop fun n => (w n : X)
    refine small_subset (s := range f) fun x hx => ?_
    obtain ⟨w, hw, hlim⟩ := mem_closure_iff_seq_limit.1 hx
    exact ⟨fun n => ⟨w n, hw n⟩, hlim.limUnder_eq⟩

/-! ### Small `⋆`-subalgebras -/

namespace NonUnitalStarAlgebra

variable {R A : Type*} [CommSemiring R] [NonUnitalSemiring A] [StarRing A] [Module R A]

variable (R) in
/-- One round of generation: the sums, products, scalar multiples and adjoints of elements of
`t`, with `t` itself. -/
private def step (t : Set A) : Set A :=
  t ∪ range (fun p : t × t => (p.1 : A) + p.2) ∪ range (fun p : t × t => (p.1 : A) * p.2) ∪
    range (fun p : R × t => p.1 • (p.2 : A)) ∪ range (fun x : t => star (x : A))

variable (R) in
/-- `k` rounds of generation from `s ∪ {0}`. -/
private def gen (s : Set A) (k : ℕ) : Set A :=
  (step R)^[k] (insert 0 s)

private lemma gen_succ (s : Set A) (k : ℕ) : gen R s (k + 1) = step R (gen R s k) :=
  Function.iterate_succ_apply' (step R) k (insert 0 s)

private lemma small_gen [Small.{u} R] (s : Set A) [Small.{u} s] (k : ℕ) :
    Small.{u} (gen R s k) := by
  induction k with
  | zero => exact small_insert 0 s
  | succ k ih =>
    rw [gen_succ]
    unfold step
    infer_instance

private lemma monotone_gen (s : Set A) : Monotone (gen R s) :=
  monotone_nat_of_le_succ fun k x hx => by
    rw [gen_succ]
    exact Or.inl (Or.inl (Or.inl (Or.inl hx)))

variable [StarRing R] [IsScalarTower R A A] [SMulCommClass R A A] [StarModule R A]

/-- The `⋆`-subalgebra generated by `s` lies in the union of the rounds of generation. -/
private lemma adjoin_subset_iUnion_gen (s : Set A) :
    (NonUnitalStarAlgebra.adjoin R s : Set A) ⊆ ⋃ k, gen R s k := by
  intro a ha
  induction ha using NonUnitalStarAlgebra.adjoin_induction with
  | mem x hx => exact mem_iUnion.2 ⟨0, Or.inr hx⟩
  | zero => exact mem_iUnion.2 ⟨0, Or.inl rfl⟩
  | add x y _ _ hx hy =>
    obtain ⟨i, hi⟩ := mem_iUnion.1 hx
    obtain ⟨j, hj⟩ := mem_iUnion.1 hy
    refine mem_iUnion.2 ⟨max i j + 1, ?_⟩
    rw [gen_succ]
    exact Or.inl (Or.inl (Or.inl (Or.inr ⟨(⟨x, monotone_gen s (le_max_left i j) hi⟩,
      ⟨y, monotone_gen s (le_max_right i j) hj⟩), rfl⟩)))
  | mul x y _ _ hx hy =>
    obtain ⟨i, hi⟩ := mem_iUnion.1 hx
    obtain ⟨j, hj⟩ := mem_iUnion.1 hy
    refine mem_iUnion.2 ⟨max i j + 1, ?_⟩
    rw [gen_succ]
    exact Or.inl (Or.inl (Or.inr ⟨(⟨x, monotone_gen s (le_max_left i j) hi⟩,
      ⟨y, monotone_gen s (le_max_right i j) hj⟩), rfl⟩))
  | smul c x _ hx =>
    obtain ⟨i, hi⟩ := mem_iUnion.1 hx
    refine mem_iUnion.2 ⟨i + 1, ?_⟩
    rw [gen_succ]
    exact Or.inl (Or.inr ⟨(c, ⟨x, hi⟩), rfl⟩)
  | star x _ hx =>
    obtain ⟨i, hi⟩ := mem_iUnion.1 hx
    refine mem_iUnion.2 ⟨i + 1, ?_⟩
    rw [gen_succ]
    exact Or.inr ⟨⟨x, hi⟩, rfl⟩

/-- **The `⋆`-subalgebra generated by a small set over a small ring is small.** -/
instance small_adjoin [Small.{u} R] {s : Set A} [Small.{u} s] :
    Small.{u} (NonUnitalStarAlgebra.adjoin R s : NonUnitalStarSubalgebra R A) := by
  have : ∀ k, Small.{u} (gen R s k) := small_gen s
  exact small_subset (adjoin_subset_iUnion_gen s)

end NonUnitalStarAlgebra

namespace NonUnitalStarSubalgebra

variable (R : Type*) {A : Type*} [CommSemiring R] [StarRing R] [TopologicalSpace A]
  [NonUnitalSemiring A] [StarRing A] [Module R A] [IsScalarTower R A A] [SMulCommClass R A A]
  [StarModule R A] [IsSemitopologicalSemiring A] [ContinuousStar A] [ContinuousConstSMul R A]
  [FrechetUrysohnSpace A] [T2Space A]

/-- **A small set of a topological `⋆`-algebra over a small ring lies in a small closed
`⋆`-subalgebra**, the closure of the `⋆`-subalgebra it generates, when the algebra is Hausdorff and
Fréchet–Urysohn; a C⋆-algebra is one. -/
theorem exists_subset_isClosed_small [Small.{u} R] (s : Set A) [Small.{u} s] :
    ∃ S : NonUnitalStarSubalgebra R A, s ⊆ S ∧ IsClosed (S : Set A) ∧ Small.{u} (S : Set A) := by
  refine ⟨(NonUnitalStarAlgebra.adjoin R s).topologicalClosure,
    (NonUnitalStarAlgebra.subset_adjoin R s).trans
      (NonUnitalStarSubalgebra.le_topologicalClosure _),
    NonUnitalStarSubalgebra.isClosed_topologicalClosure _, ?_⟩
  have : Small.{u} (NonUnitalStarAlgebra.adjoin R s : Set A) := NonUnitalStarAlgebra.small_adjoin
  exact small_closure (NonUnitalStarAlgebra.adjoin R s : Set A)

end NonUnitalStarSubalgebra

/-! ### The C⋆-algebra structure on `Shrink` -/

namespace Shrink

variable (R A : Type*) [Small.{v} A]

variable {R A} in
/-- The transfer `Shrink.{v} A ≃ A` commutes with the scalar action. -/
lemma ringEquiv_smul [Semiring R] [NonUnitalNonAssocSemiring A] [Module R A] (c : R)
    (x : Shrink.{v} A) : Shrink.ringEquiv A (c • x) = c • Shrink.ringEquiv A x :=
  map_smul (Shrink.linearEquiv R A) c x

/-- The scalar action on `Shrink.{v} A` is compatible with left multiplication. -/
instance instIsScalarTower [Semiring R] [NonUnitalNonAssocSemiring A] [Module R A]
    [IsScalarTower R A A] :
    IsScalarTower R (Shrink.{v} A) (Shrink.{v} A) where
  smul_assoc c x y := by
    apply EquivLike.injective (Shrink.ringEquiv A)
    simp only [smul_eq_mul, map_mul, ringEquiv_smul, smul_mul_assoc]

/-- The scalar action on `Shrink.{v} A` is compatible with right multiplication. -/
instance instSMulCommClass [Semiring R] [NonUnitalNonAssocSemiring A] [Module R A]
    [SMulCommClass R A A] :
    SMulCommClass R (Shrink.{v} A) (Shrink.{v} A) where
  smul_comm c x y := by
    apply EquivLike.injective (Shrink.ringEquiv A)
    simp only [smul_eq_mul, map_mul, ringEquiv_smul, mul_smul_comm]

section Star

variable [NonUnitalNonAssocSemiring A] [StarRing A]

/-- The star structure on `Shrink.{v} A`, transferred along `equivShrink A`. -/
noncomputable instance instStarRing : StarRing (Shrink.{v} A) :=
  (equivShrink A).symm.starRing

variable {A} in
/-- The transfer `Shrink.{v} A ≃ A` commutes with the star. -/
lemma ringEquiv_star (x : Shrink.{v} A) : Shrink.ringEquiv A (star x) = star (Shrink.ringEquiv A x) :=
  (equivShrink A).symm_apply_apply _

/-- The transfer `Shrink.{v} A ≃ A` as a `⋆`-isomorphism. -/
noncomputable def starAlgEquiv [Semiring R] [Module R A] : Shrink.{v} A ≃⋆ₐ[R] A where
  toEquiv := (equivShrink A).symm
  map_mul' := map_mul (Shrink.ringEquiv A)
  map_add' := map_add (Shrink.ringEquiv A)
  map_star' := ringEquiv_star
  map_smul' := ringEquiv_smul

/-- `Shrink.starAlgEquiv R A` is the inverse of `equivShrink A`. -/
lemma starAlgEquiv_apply [Semiring R] [Module R A] (x : Shrink.{v} A) :
    starAlgEquiv R A x = (equivShrink A).symm x :=
  rfl

/-- The scalar action on `Shrink.{v} A` is compatible with the star. -/
instance instStarModule [Semiring R] [Star R] [Module R A] [StarModule R A] :
    StarModule R (Shrink.{v} A) where
  star_smul c x := by
    apply EquivLike.injective (Shrink.ringEquiv A)
    simp only [ringEquiv_star, ringEquiv_smul, star_smul]

end Star

/-- The norm of `Shrink.{v} A` is that of `A`. -/
lemma norm_starAlgEquiv [Semiring R] [NonUnitalSeminormedRing A] [StarRing A] [Module R A]
    (x : Shrink.{v} A) : ‖starAlgEquiv R A x‖ = ‖x‖ :=
  rfl

/-- The normed ring structure on `Shrink.{v} A`, transferred along `equivShrink A`. -/
noncomputable instance instNonUnitalNormedRing [NonUnitalNormedRing A] :
    NonUnitalNormedRing (Shrink.{v} A) where
  __ := (inferInstance : NormedAddCommGroup (Shrink.{v} A))
  __ := (inferInstance : NonUnitalRing (Shrink.{v} A))
  norm_mul_le x y := by
    change ‖Shrink.ringEquiv A (x * y)‖ ≤ ‖Shrink.ringEquiv A x‖ * ‖Shrink.ringEquiv A y‖
    rw [map_mul]
    exact norm_mul_le _ _

/-- `Shrink.{v} A` is complete when `A` is: the transfer is an isometry onto `A`. -/
instance instCompleteSpace [SeminormedAddCommGroup A] [CompleteSpace A] :
    CompleteSpace (Shrink.{v} A) := by
  have hiso : Isometry (Shrink.addEquiv (α := A)) :=
    AddMonoidHomClass.isometry_of_norm _ fun _ => rfl
  rw [completeSpace_iff_isComplete_range hiso.isUniformInducing,
    Set.range_eq_univ.2 (EquivLike.surjective Shrink.addEquiv)]
  exact isComplete_univ

/-- `Shrink.{v} A` satisfies the C⋆-identity when `A` does. -/
instance instCStarRing [NonUnitalNormedRing A] [StarRing A] [CStarRing A] :
    CStarRing (Shrink.{v} A) where
  norm_mul_self_le x := by
    change ‖Shrink.ringEquiv A x‖ * ‖Shrink.ringEquiv A x‖ ≤ ‖Shrink.ringEquiv A (star x * x)‖
    rw [map_mul, ringEquiv_star]
    exact CStarRing.norm_mul_self_le _

/-- **A small C⋆-algebra has a copy in the smaller universe**: `Shrink.{v} A` is a C⋆-algebra,
`⋆`-isomorphic to `A` by `Shrink.starAlgEquiv ℂ A`. -/
noncomputable instance instNonUnitalCStarAlgebra [NonUnitalCStarAlgebra A] :
    NonUnitalCStarAlgebra (Shrink.{v} A) where

end Shrink
