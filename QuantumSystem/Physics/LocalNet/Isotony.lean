module

public import Mathlib.Analysis.CStarAlgebra.Classes
public import Mathlib.Order.DirectedInverseSystem

/-!
# Nets of C⋆-algebras: isotony

A **net of C⋆-algebras** `CStarNet` over an ordered set `K` of regions assigns to each region a
local C⋆-algebra, with functorial **isotony** embeddings `𝔄(O) →⋆ₐ[ℂ] 𝔄(O')` for `O ≤ O'`. This is
the part of the Haag–Kastler structure that needs the order of `K` alone: no causal orthogonality,
no grading, no locality. Those are added on top of it, each in its own file:

* `QuantumSystem.Physics.LocalNet.Grading` — a parity automorphism of every local algebra;
* `QuantumSystem.Physics.LocalNet.Locality` — graded locality for a causal orthogonality relation
  on `K` (`QuantumSystem.Physics.LocalNet.Orthogonality`);
* `QuantumSystem.Physics.LocalNet.Basic` — the graded-local net `GradedLocalNet`, which extends
  `CStarNet` by the two.

Everything that uses only the isotony embeddings is stated here and in the files importing this one
alone, in the namespace `CStarNet`, and applies to a `GradedLocalNet` through
`GradedLocalNet.toCStarNet`: faithfulness (`CStarNet.Faithful`), the transport of local algebras
along equalities of regions (`CStarNet.algebraCongr`), and the quasi-local algebra
(`QuantumSystem.Physics.LocalNet.QuasiLocalAlgebra`).

Additivity and generation (e.g. `𝔄(O₁ ⊔ O₂)` being generated by the images of `𝔄(O₁)` and
`𝔄(O₂)`, as in tensor-product spin-system nets) are not formalized. They are properties of a net,
not of a particular model, and when added they are stated as such, at the level of the nets of von
Neumann algebras (`VonNeumannNet`), where joins of local algebras can be formed.

## Notation

`𝔄(O)` in the prose is documentation shorthand, following the AQFT literature, for the local
C⋆-algebra `N.algebra O` of a region. `𝓡(O)` abbreviates the local von Neumann algebra of a region
in whichever net of von Neumann algebras is in play: `vnNet.algebra O` for a net
`vnNet : VonNeumannNet K H`; for the net of a representation `π` of a net of C⋆-algebras,
`π.vonNeumannNet.algebra O = π(𝔄(O))″`, and for a representation `R` of the quasi-local algebra,
`N.localVonNeumannAlgebra R O`; for an infinite lattice region `S`, `vnNet.extend.algebra S`. Each
file's Notation section says which is meant there. Neither symbol is a Lean notation, and
deliberately so: the objects carry the net — and `𝓡(O)` also the representation — as parameters
that a bare `𝔄(O)` could not capture, so a faithful notation would have to spell them out anyway.
The symbols stay in the prose; the code writes the projections.
-/

@[expose] public section

/-- A **net of C⋆-algebras** over an ordered set `K` of regions: the assignment `O ↦ 𝔄(O)` together
    with isotony embeddings `incl : 𝔄(O) →⋆ₐ[ℂ] 𝔄(O')` for `O ≤ O'`, functorial
    (`incl_refl`/`incl_trans`). The embeddings are *not* required to be injective; that is the
    class `CStarNet.Faithful`. Lattice nets are the instance `K = Finset sites`. -/
structure CStarNet (K : Type*) [Preorder K] where
  /-- The local C⋆-algebra `𝔄(O)` assigned to a region. -/
  algebra : K → Type*
  /-- Each local algebra is a (complex) C⋆-algebra. -/
  [algebraCStar : ∀ O, CStarAlgebra (algebra O)]
  /-- **Isotony**: for `O ≤ O'` an inclusion of local algebras as a unital `*`-homomorphism. -/
  incl : ∀ {O O' : K}, O ≤ O' → (algebra O →⋆ₐ[ℂ] algebra O')
  /-- The identity inclusion `O ≤ O` acts as the identity. -/
  incl_refl : ∀ {O : K} (x : algebra O), incl (le_refl O) x = x
  /-- **Functoriality**: the inclusions compose, so the net is a directed system. -/
  incl_trans : ∀ {O₁ O₂ O₃ : K} (h₁₂ : O₁ ≤ O₂) (h₂₃ : O₂ ≤ O₃) (x : algebra O₁),
      incl h₂₃ (incl h₁₂ x) = incl (h₁₂.trans h₂₃) x

attribute [instance] CStarNet.algebraCStar

namespace CStarNet

variable {K : Type*} [Preorder K] (N : CStarNet K)

/-- The net forms a directed system of `*`-algebras: the isotony embeddings compose and the
    identity inclusion is the identity. -/
instance directedSystem :
    DirectedSystem N.algebra (fun _ _ h => ⇑(N.incl h)) where
  map_self _ x := N.incl_refl x
  map_map _ _ _ hij hjk x := N.incl_trans hij hjk x

/-! ### Faithful nets

A net is *faithful* when its isotony embeddings are injective (the standard AQFT
non-degeneracy condition). The quasi-local C⋆-norm built from this hypothesis lives in
`QuantumSystem.Physics.LocalNet.QuasiLocalAlgebra`.
-/

/-- A net is **faithful** when all its isotony embeddings are injective. In the standard AQFT
    definition the isotony embeddings are *injective* unital `*`-homomorphisms, so over a directed
    index set the literature's net is a local net (`GradedLocalNet` with `GradedLocalNet.IsTriviallyGraded`)
    together with `Faithful`. Over a non-directed one the locality of a `GradedLocalNet` binds only
    the pairs with a common upper bound (`CStarNet.Grading.IsGradedLocal`).
    Carried as a typeclass rather than a structure field so algebraic constructions can state the
    non-degeneracy hypothesis only where they need it. -/
class Faithful {K : Type*} [Preorder K] (N : CStarNet K) : Prop where
  /-- Every isotony embedding of the net is injective. -/
  incl_injective : ∀ {O O' : K} (h : O ≤ O'), Function.Injective (N.incl h)

/-! ### Region-equality transport -/

/-- Transport a local algebra along an equality of regions, as a `*`-isomorphism. Used to identify
    local algebras whose regions are propositionally equal. -/
def algebraCongr {O O' : K} (h : O = O') : N.algebra O ≃⋆ₐ[ℂ] N.algebra O' := by
  subst h; exact StarAlgEquiv.refl ℂ _

/-- The isotony embeddings are natural with respect to the region-equality transport. -/
lemma incl_algebraCongr {O₁ O₂ O₁' O₂' : K} (e₁ : O₁ = O₁') (e₂ : O₂ = O₂')
    (h : O₁ ≤ O₂) (h' : O₁' ≤ O₂') (x : N.algebra O₁) :
    N.algebraCongr e₂ (N.incl h x) = N.incl h' (N.algebraCongr e₁ x) := by
  subst e₁; subst e₂; rfl

/-- Transports along composable region equalities compose. -/
@[simp] lemma algebraCongr_trans {O₁ O₂ O₃ : K} (h₁ : O₁ = O₂) (h₂ : O₂ = O₃)
    (x : N.algebra O₁) :
    N.algebraCongr h₂ (N.algebraCongr h₁ x) = N.algebraCongr (h₁.trans h₂) x := by
  subst h₁; subst h₂; rfl

/-- A transport along a reflexive region equality is the identity. -/
@[simp] lemma algebraCongr_self {O : K} (h : O = O) (x : N.algebra O) :
    N.algebraCongr h x = x := by
  rw [Subsingleton.elim h rfl]; rfl

/-- Cancelling a transport against a target value moves it to the other side. -/
lemma algebraCongr_eq_iff {O O' : K} (h : O = O') (x : N.algebra O)
    (y : N.algebra O') : N.algebraCongr h x = y ↔ x = N.algebraCongr h.symm y := by
  subst h; simp

end CStarNet
