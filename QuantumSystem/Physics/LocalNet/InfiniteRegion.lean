module

public import QuantumSystem.Physics.LocalNet.SplitProperty

/-!
# Infinite lattice regions

On the finite regions of a lattice the split property says nothing about a spin net: in a unital
representation every local von Neumann algebra `𝓡(Λ)` of a finite region is a finite-dimensional
factor, hence a type I factor, and every inclusion between two of them splits. The lattice
literature's split property — the half-chain split property of a spin chain, the split property
for cones — is a statement about **infinite**
regions. This module makes those regions available.

* The infinite regions are `Set α`, with causal orthogonality `Disjoint`
  (the `CausalOrthogonality (Set α)` instance in `QuantumSystem.Physics.LocalNet.Orthogonality`).
* `ProperContainment.ofCThickening α δ` is the separating proper containment of a metric on the
  sites: `S₁ ⋐ S₂` iff the closed `δ`-thickening of `S₁` lies strictly inside `S₂`;
  `ProperContainment.ofCThickeningFinset α δ` is the same relation on the finite regions.
* `VonNeumannNet.extendAlong vnNet ι` extends a net along a map `ι : K → L` of index sets: `𝓡(S)` is
  the von Neumann algebra generated by the `𝓡(O)` with `ι O ≤ S`. It agrees with the net along an
  order embedding (`VonNeumannNet.extendAlong_algebra_apply`), a grading of the net grades it
  (`VonNeumannNet.Grading.extendAlong`), and graded locality and locality pass to it when `ι`
  reflects causal orthogonality (`VonNeumannNet.Grading.IsGradedLocal.extendAlong`,
  `VonNeumannNet.isLocal_extendAlong`).
* `VonNeumannNet.extend` is the case of the inclusion of the finite regions into the infinite ones:
  `𝓡(S)` is generated by the `𝓡(Λ)` of the finite regions `Λ ⊆ S`. It agrees with the given net on
  finite regions (`VonNeumannNet.extend_algebra_coe`), and graded locality and locality pass to it
  (`VonNeumannNet.Grading.IsGradedLocal.extend`, `VonNeumannNet.instIsLocalExtend`).
* `CStarNet.vonNeumannNetSet R` is that extension of the local von Neumann algebras of a
  representation, so `(N.vonNeumannNetSet R).SplitProperty` is the split property of a lattice net
  `N : GradedLocalNet (Finset α)` on infinite regions.

The split property of a state on these regions, and the half-chain split property in
particular, are in `QuantumSystem.Physics.LocalNet.HalfChainSplit`.

## Notation

`𝓡(Λ)` and `𝓡(S)` in the prose above are documentation shorthand for `vnNet.algebra Λ` of a
finite region and `vnNet.extend.algebra S` of an arbitrary one (`𝓡(O)` for
`(vnNet.extendAlong ι).algebra`), following the convention stated in
`QuantumSystem.Physics.LocalNet.Isotony`.
-/

@[expose] public section

open scoped ProperContainment VonNeumannAlgebra CausalOrthogonality

namespace ProperContainment

/-- **Proper containment of infinite lattice regions from a metric on the sites**: `S₁ ⋐ S₂` iff
    the closed `δ`-thickening `Metric.cthickening δ S₁` is a strict subset of `S₂`, for a
    *positive* width `δ`. The closed thickening is monotone and contains the region, so this is
    `ofThicken`; it is the metric form of the literature's separation "`Ō₁` lies inside `O₂` with
    room to spare" (`closure_subset_interior_of_properlyContained`).

    Positivity is what makes the room to spare: at `δ ≤ 0` the closed thickening is the closure,
    and on the discrete `Set ℤ` the model would collapse to `ofLT`, admitting the touching pair
    `Iic 0 ⋐ Iic 1`. On the integer chain `δ = 1` gives the nearest-neighbour buffer, as the finite
    model `ofCThickeningFinset` does on finite regions. A `def` rather than an instance: a global
    instance would fix one metric and one `δ` for every downstream `Set α`. -/
@[reducible] noncomputable def ofCThickening (α : Type*) [PseudoMetricSpace α]
    (δ : {δ : ℝ // 0 < δ}) : ProperContainment (Set α) :=
  ofThicken (fun _ _ h => h) (Metric.cthickening δ) Metric.self_subset_cthickening
    (fun _ _ h => Metric.cthickening_subset_of_subset δ h)

open scoped ProperContainment in
/-- **The metric proper containment is the literature's separation**: under
    `ofCThickening α δ`, `S₁ ⋐ S₂` puts the closure of `S₁` inside the interior of `S₂`. The open
    `δ`-thickening of `S₁` is an open set containing `closure S₁` (this is where `0 < δ` enters)
    and contained in the closed one, hence in `S₂`. -/
lemma closure_subset_interior_of_properlyContained {α : Type*} [PseudoMetricSpace α]
    {δ : {δ : ℝ // 0 < δ}} {S₁ S₂ : Set α}
    (h : letI := ofCThickening α δ; S₁ ⋐ S₂) : closure S₁ ⊆ interior S₂ :=
  (Metric.closure_subset_thickening δ.2 S₁).trans <| interior_maximal
    ((Metric.thickening_subset_cthickening (δ : ℝ) S₁).trans
      (show Metric.cthickening (δ : ℝ) S₁ < S₂ from h).le) Metric.isOpen_thickening

/-- **Proper containment of finite lattice regions from a metric on the sites**: `Λ₁ ⋐ Λ₂` iff the
    closed `δ`-thickening of `Λ₁` is a strict subset of `Λ₂`, for a *positive* width `δ` — the
    relation of `ofCThickening` on the underlying sets
    (`ofCThickeningFinset_properlyContained_iff`). The thickening of a finite set need not be
    finite, so this is not an `ofThicken`; the collar is a single site of `Λ₂` outside the
    thickening. On `Fin d → ℤ` with its sup metric and `δ = ℓ`, the thickening is the set of sites
    at `ℓ∞`-distance at most `ℓ` from the region. A `def` rather than an instance, for the same
    reason as `ofCThickening`. -/
@[reducible] noncomputable def ofCThickeningFinset (α : Type*) [PseudoMetricSpace α]
    (δ : {δ : ℝ // 0 < δ}) : ProperContainment (Finset α) where
  ProperlyContained Λ₁ Λ₂ := Metric.cthickening δ (Λ₁ : Set α) < Λ₂
  le_of_properlyContained Λ₁ _ h :=
    Finset.coe_subset.mp ((Metric.self_subset_cthickening (Λ₁ : Set α)).trans h.le)
  properlyContained_mono _ _ _ _ h₀ h h₃ :=
    ((Metric.cthickening_subset_of_subset δ (Finset.coe_subset.2 h₀)).trans_lt h).trans_le
      (Finset.coe_subset.2 h₃)
  exists_orthogonal_of_properlyContained Λ₁ _ h := by
    obtain ⟨x, hx₂, hx⟩ := Set.exists_of_ssubset h
    have hx₁ : x ∉ Λ₁ := fun hx₁ => hx (Metric.self_subset_cthickening (Λ₁ : Set α) hx₁)
    exact ⟨{x}, Finset.singleton_subset_iff.2 hx₂, Finset.disjoint_singleton_right.2 hx₁,
      fun hle => hx₁ (Finset.singleton_subset_iff.1 hle)⟩

/-- The finite-region metric proper containment is the infinite-region one on the underlying
    sets. -/
lemma ofCThickeningFinset_properlyContained_iff {α : Type*} [PseudoMetricSpace α]
    {δ : {δ : ℝ // 0 < δ}} {Λ₁ Λ₂ : Finset α} :
    (letI := ofCThickeningFinset α δ; Λ₁ ⋐ Λ₂) ↔
      (letI := ofCThickening α δ; (Λ₁ : Set α) ⋐ (Λ₂ : Set α)) :=
  Iff.rfl

end ProperContainment

namespace VonNeumannNet

variable {K L : Type*} [Preorder K] [Preorder L]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Extension along a map of index sets -/

/-- The operators localised in a region `O` of `K` with `ι O ≤ S`: the union of the algebras
    `vnNet.algebra O` over those regions. It generates `(vnNet.extendAlong ι).algebra S`. -/
def localOperatorsAlong (vnNet : VonNeumannNet K H) (ι : K → L) (S : L) : Set (H →L[ℂ] H) :=
  ⋃ (O : K) (_ : ι O ≤ S), (vnNet.algebra O : Set (H →L[ℂ] H))

/-- Membership in `localOperatorsAlong`: `x` is localised in some region `O` with `ι O ≤ S`. -/
lemma mem_localOperatorsAlong {vnNet : VonNeumannNet K H} {ι : K → L} {S : L} {x : H →L[ℂ] H} :
    x ∈ vnNet.localOperatorsAlong ι S ↔ ∃ O : K, ι O ≤ S ∧ x ∈ vnNet.algebra O := by
  simp [localOperatorsAlong]

/-- **The extension of a net along a map of index sets** `ι : K → L`: the von Neumann algebra of a
    region `S` of `L` is the one generated by the algebras of the regions `O` of `K` with
    `ι O ≤ S`, `𝓡(S) = (⋃_{ι O ≤ S} 𝓡(O))″`. Isotony is monotonicity of `generated`. Along an order
    embedding it agrees with the net (`VonNeumannNet.extendAlong_algebra_apply`); graded locality and
    locality pass to it when `ι` reflects causal orthogonality
    (`VonNeumannNet.Grading.IsGradedLocal.extendAlong`, `VonNeumannNet.isLocal_extendAlong`). -/
noncomputable def extendAlong (vnNet : VonNeumannNet K H) (ι : K → L) : VonNeumannNet L H where
  algebra S := VonNeumannAlgebra.generated (vnNet.localOperatorsAlong ι S)
  algebra_mono _ _ h := VonNeumannAlgebra.generated_mono fun x hx => by
    obtain ⟨O, hO, hx⟩ := mem_localOperatorsAlong.1 hx
    exact mem_localOperatorsAlong.2 ⟨O, hO.trans h, hx⟩

/-- A region's algebra lies in the extended algebra of every region above its image. -/
lemma algebra_le_extendAlong_algebra (vnNet : VonNeumannNet K H) {ι : K → L} {O : K} {S : L}
    (h : ι O ≤ S) : vnNet.algebra O ≤ (vnNet.extendAlong ι).algebra S := fun _ hx =>
  VonNeumannAlgebra.mem_generated_of_mem (mem_localOperatorsAlong.2 ⟨O, h, hx⟩)

/-- **The extension along an order embedding agrees with the net**: `𝓡(ι O) = 𝓡(O)`. -/
@[simp] lemma extendAlong_algebra_apply (vnNet : VonNeumannNet K H) (ι : K ↪o L) (O : K) :
    (vnNet.extendAlong ι).algebra (ι O) = vnNet.algebra O := by
  refine le_antisymm (VonNeumannAlgebra.generated_le fun x hx => ?_)
    (vnNet.algebra_le_extendAlong_algebra le_rfl)
  obtain ⟨O₀, hO₀, hx⟩ := mem_localOperatorsAlong.1 hx
  exact vnNet.algebra_mono (ι.le_iff_le.1 hO₀) hx

/-- **A grading of a net grades its extension**, by the same unitary: it maps every generator of
    `𝓡(S)` into `𝓡(S)`, hence `𝓡(S)` into itself. -/
noncomputable def Grading.extendAlong {vnNet : VonNeumannNet K H} (G : vnNet.Grading)
    (ι : K → L) : (vnNet.extendAlong ι).Grading where
  Γ := G.Γ
  isSelfAdjoint_Γ := G.isSelfAdjoint_Γ
  Γ_mul_Γ := G.Γ_mul_Γ
  Γ_mul_mul_Γ_mem S _ hx := by
    refine VonNeumannAlgebra.mul_mul_mem_generated_of_isSelfAdjoint G.isSelfAdjoint_Γ G.Γ_mul_Γ
      (fun y hy => ?_) hx
    obtain ⟨O, hO, hy⟩ := mem_localOperatorsAlong.1 hy
    exact VonNeumannAlgebra.mem_generated_of_mem
      (mem_localOperatorsAlong.2 ⟨O, hO, G.Γ_mul_mul_Γ_mem hy⟩)

/-- The grading unitary of the extended grading is that of the grading. -/
@[simp] lemma Grading.extendAlong_Γ {vnNet : VonNeumannNet K H} (G : vnNet.Grading) (ι : K → L) :
    (G.extendAlong ι).Γ = G.Γ :=
  rfl

/-- **Graded locality passes to the extension along a map reflecting causal orthogonality**: every
    generator of `𝓡(S₁)` lies in some `𝓡(O₁)` with `ι O₁ ≤ S₁`, and every generator of `𝓡(S₂)` in
    some `𝓡(O₂)` with `ι O₂ ≤ S₂`; when `S₁ ⟂ S₂`, heredity gives `ι O₁ ⟂ ι O₂`, hence `O₁ ⟂ O₂`,
    so the twisted commutation of the generators is that of the net (`Grading.isGradedLocal_of_generated`). -/
lemma Grading.IsGradedLocal.extendAlong [CausalOrthogonality K] [CausalOrthogonality L]
    {vnNet : VonNeumannNet K H} {G : vnNet.Grading} {ι : K → L}
    (hι : ∀ ⦃O₁ O₂ : K⦄, ι O₁ ⟂ ι O₂ → O₁ ⟂ O₂)
    (hG : G.IsGradedLocal) : (G.extendAlong ι).IsGradedLocal := by
  refine (G.extendAlong ι).isGradedLocal_of_generated (vnNet.localOperatorsAlong ι)
    (fun _ => rfl) ?_
  intro S₁ S₂ hd x hx y hy
  obtain ⟨O₁, hO₁, hx⟩ := mem_localOperatorsAlong.1 hx
  obtain ⟨O₂, hO₂, hy⟩ := mem_localOperatorsAlong.1 hy
  have h := G.isGradedLocal_iff_commute_twist.1 hG (hι (hd.mono hO₁ hO₂))
  exact ⟨h hx hy, h hx (star_mem hy)⟩

/-- **Locality passes to the extension along a map reflecting causal orthogonality**: the case of
    the trivial grading of `Grading.IsGradedLocal.extendAlong`. -/
lemma isLocal_extendAlong [CausalOrthogonality K] [CausalOrthogonality L]
    (vnNet : VonNeumannNet K H) [vnNet.IsLocal] {ι : K → L}
    (hι : ∀ ⦃O₁ O₂ : K⦄, ι O₁ ⟂ ι O₂ → O₁ ⟂ O₂) :
    (vnNet.extendAlong ι).IsLocal :=
  Grading.isGradedLocal_trivial_iff.1 <|
    (Grading.IsGradedLocal.extendAlong (G := Grading.trivial vnNet) hι
      (Grading.isGradedLocal_trivial_iff.2 ‹_›) :)

/-! ### Infinite lattice regions -/

variable {α : Type*}

/-- **The extension of a finite-region net to infinite regions**: the von Neumann algebra of an
    arbitrary region `S` is the one generated by the algebras of the finite regions inside `S`,
    `𝓡(S) = (⋃_{Λ ⊆ S finite} 𝓡(Λ))″` — the extension along the inclusion of the finite regions
    (`VonNeumannNet.extendAlong`). This is how the lattice literature assigns algebras to
    half-chains and cones. -/
noncomputable abbrev extend (vnNet : VonNeumannNet (Finset α) H) : VonNeumannNet (Set α) H :=
  vnNet.extendAlong ((↑) : Finset α → Set α)

/-- **The extension agrees with the net on finite regions**: `𝓡(↑Λ) = 𝓡(Λ)`. So the
    infinite-region net genuinely extends the finite one, and its split property restricted to
    finite pairs is the finite-region property. -/
@[simp] lemma extend_algebra_coe (vnNet : VonNeumannNet (Finset α) H) (Λ : Finset α) :
    vnNet.extend.algebra (Λ : Set α) = vnNet.algebra Λ :=
  vnNet.extendAlong_algebra_apply Finset.coeEmb Λ

/-- A grading of a finite-region net grades its extension to infinite regions. -/
noncomputable abbrev Grading.extend {vnNet : VonNeumannNet (Finset α) H} (G : vnNet.Grading) :
    vnNet.extend.Grading :=
  G.extendAlong ((↑) : Finset α → Set α)

/-- **Graded locality passes to the extension to infinite regions.** -/
lemma Grading.IsGradedLocal.extend {vnNet : VonNeumannNet (Finset α) H} {G : vnNet.Grading}
    (hG : G.IsGradedLocal) : G.extend.IsGradedLocal :=
  hG.extendAlong fun _ _ => Finset.disjoint_coe.1

/-- **Locality passes to the extension to infinite regions.** -/
instance instIsLocalExtend (vnNet : VonNeumannNet (Finset α) H) [vnNet.IsLocal] :
    vnNet.extend.IsLocal :=
  vnNet.isLocal_extendAlong fun _ _ => Finset.disjoint_coe.1

end VonNeumannNet

namespace CStarNet

variable {α : Type*} (N : CStarNet (Finset α)) [N.Faithful]

/-- **The local von Neumann algebras of infinite regions** in a representation `R` of the
    quasi-local C⋆-algebra of a lattice net: the extension (`VonNeumannNet.extend`) of the net
    `N.vonNeumannNet R` of finite-region algebras. Its split property,
    `(N.vonNeumannNetSet R).SplitProperty`, is the lattice split property on infinite regions. -/
noncomputable abbrev vonNeumannNetSet (R : CStarRep N.quasiLocalCStarAlgebra) :
    VonNeumannNet (Set α) R.H :=
  (N.vonNeumannNet R).extend

/-- On a finite region the infinite-region net is the local von Neumann algebra of that region. -/
lemma vonNeumannNetSet_algebra_coe (R : CStarRep N.quasiLocalCStarAlgebra) (Λ : Finset α) :
    (N.vonNeumannNetSet R).algebra (Λ : Set α) = N.localVonNeumannAlgebra R Λ :=
  (N.vonNeumannNet R).extend_algebra_coe Λ

end CStarNet
