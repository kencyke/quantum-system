module

public import Mathlib.Analysis.Complex.Basic
public import QuantumSystem.ForMathlib.Analysis.VonNeumannAlgebra.Commutant
public import QuantumSystem.Physics.LocalNet.Orthogonality

/-!
# Nets of von Neumann algebras

A **net of von Neumann algebras** (`VonNeumannNet`) is an isotone assignment `O ↦ 𝓡(O)` of von
Neumann algebras on a fixed Hilbert space over an ordered set of regions, and nothing more: no
directedness, no locality. This is the definition of Carpi–Kawahigashi–Longo (*Structure and
Classification of Superconformal Nets*, Ann. Henri Poincaré 9 (2008), §2.1), there over the
intervals of `S¹`, which are not directed: two intervals covering the circle have no upper bound.

What a causal orthogonality relation `⟂` on the regions demands of a net is stated on top of it, in
its graded form (*ibid.*, §2.1). A **grading** (`VonNeumannNet.Grading`) is a selfadjoint unitary
`Γ` on `H` whose adjoint action `x ↦ Γ x Γ` maps every `𝓡(O)` into itself; `x` is *even* if
`Γ x Γ = x` and *odd* if `Γ x Γ = -x`. The net is **graded-local** with respect to `Γ`
(`VonNeumannNet.Grading.IsGradedLocal`) when, for causally orthogonal regions, even elements commute
with everything and odd elements anticommute. Graded locality is **twisted locality**
`𝓡(O₁) ≤ Z 𝓡(O₂)′ Z⋆` for the unitary `Z = (1 - iΓ) / (1 - i)`
(`VonNeumannNet.Grading.isGradedLocal_iff_le_conj_commutant`).

A net is **local** (`VonNeumannNet.IsLocal`) when causally orthogonal regions carry commuting
algebras, `𝓡(O₁) ≤ 𝓡(O₂)′`, which is graded locality for the trivial grading `Γ = 1`
(`VonNeumannNet.Grading.isGradedLocal_trivial_iff`). The ambient `𝓑(H)` states these relations for
every causally orthogonal pair, with no common upper bound needed, which a net of C⋆-algebras over
a non-directed index set cannot do (`QuantumSystem.Physics.LocalNet.Locality`).

The local von Neumann algebras of a representation of a net of C⋆-algebras form a net of von
Neumann algebras; they are in `QuantumSystem.Physics.LocalNet.Representation`, and a graded-local
net that is not local is in `QuantumSystem.Physics.LocalNet.Examples`.

## Main definitions

* `VonNeumannNet K H` — an isotone net of von Neumann algebras on `H` over the regions `K`.
* `VonNeumannNet.Grading N` — a grading of the net `N`; `VonNeumannNet.Grading.trivial N` — `Γ = 1`.
* `VonNeumannNet.Grading.twist G` — the unitary `Z = (1 - iΓ) / (1 - i)`.
* `VonNeumannNet.Grading.IsGradedLocal G` — graded locality of the net with the grading `G`.
* `VonNeumannNet.IsLocal N` — locality of the net.

## Main results

* **`VonNeumannNet.Grading.isGradedLocal_iff_le_conj_commutant`** — graded locality is twisted
  locality.
* `VonNeumannNet.Grading.isGradedLocal_trivial_iff` — for the trivial grading, graded locality is
  locality.
* `VonNeumannNet.Grading.isGradedLocal_of_generated` — graded locality of nets generated by sets of
  operators, checked on the generators.

## Notation

`𝓡(O)` in the prose is documentation shorthand for `N.algebra O`, following the convention stated
in `QuantumSystem.Physics.LocalNet.Isotony`.
-/

@[expose] public section

open scoped CausalOrthogonality VonNeumannAlgebra
open Complex

/-- A **net of von Neumann algebras** over an ordered set `K` of regions, acting on a fixed Hilbert
    space `H`: the assignment `O ↦ 𝓡(O)` together with **isotony** (`algebra_mono`). This is the
    definition of Carpi–Kawahigashi–Longo (2008, §2.1) over an arbitrary ordered set of regions;
    graded locality and locality are the properties `VonNeumannNet.Grading.IsGradedLocal` and
    `VonNeumannNet.IsLocal`. -/
@[ext] structure VonNeumannNet (K : Type*) [Preorder K]
    (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] where
  /-- The local von Neumann algebra `𝓡(O)` assigned to a region. -/
  algebra : K → VonNeumannAlgebra H
  /-- **Isotony**: a larger region carries a larger algebra. -/
  algebra_mono : Monotone algebra

namespace VonNeumannNet

variable {K : Type*} [Preorder K]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Gradings -/

/-- A **grading** of a net of von Neumann algebras: a selfadjoint unitary `Γ` whose adjoint action
    `x ↦ Γ x Γ` maps every local algebra into itself. An operator `x` is *even* if `Γ x Γ = x` and
    *odd* if `Γ x Γ = -x`.

    Carpi–Kawahigashi–Longo (2008, §2.1) take an involutive automorphism `Ad Γ` of the net with `Γ`
    fixing the vacuum vector; with no vacuum here, `Γ` is taken selfadjoint, as they note one may
    for the grading unitary of a representation (§2.4). -/
structure Grading (N : VonNeumannNet K H) where
  /-- The grading unitary. -/
  Γ : H →L[ℂ] H
  /-- The grading unitary is selfadjoint. -/
  isSelfAdjoint_Γ : IsSelfAdjoint Γ
  /-- The grading unitary is an involution. -/
  Γ_mul_Γ : Γ * Γ = 1
  /-- The adjoint action of the grading unitary maps every local algebra into itself. -/
  Γ_mul_mul_Γ_mem : ∀ ⦃O : K⦄ ⦃x : H →L[ℂ] H⦄, x ∈ N.algebra O → Γ * x * Γ ∈ N.algebra O

namespace Grading

variable {N : VonNeumannNet K H} (G : N.Grading)

variable (N) in
/-- The **trivial grading** `Γ = 1`: every operator is even. -/
protected def trivial : N.Grading where
  Γ := 1
  isSelfAdjoint_Γ := IsSelfAdjoint.one _
  Γ_mul_Γ := one_mul 1
  Γ_mul_mul_Γ_mem _ _ hx := by simpa using hx

/-- The grading unitary of the trivial grading is `1`. -/
@[simp] lemma trivial_Γ : (Grading.trivial N).Γ = 1 := rfl

/-- The grading unitary is selfadjoint. -/
lemma star_Γ : star G.Γ = G.Γ := G.isSelfAdjoint_Γ.star_eq

/-- Cancelling the grading unitary on the left: `Γ (Γ x) = x`. -/
@[simp] lemma Γ_mul_Γ_mul (x : H →L[ℂ] H) : G.Γ * (G.Γ * x) = x := by
  rw [← mul_assoc, G.Γ_mul_Γ, one_mul]

/-- An operator is even iff it commutes with the grading unitary. -/
lemma Γ_mul_mul_Γ_eq_self_iff {x : H →L[ℂ] H} : G.Γ * x * G.Γ = x ↔ Commute G.Γ x := by
  constructor
  · intro h
    change G.Γ * x = x * G.Γ
    conv_rhs => rw [← h]
    rw [mul_assoc, G.Γ_mul_Γ, mul_one]
  · intro h
    rw [h.eq, mul_assoc, G.Γ_mul_Γ, mul_one]

/-- An operator is odd iff it anticommutes with the grading unitary. -/
lemma Γ_mul_mul_Γ_eq_neg_iff {x : H →L[ℂ] H} :
    G.Γ * x * G.Γ = -x ↔ G.Γ * x = -(x * G.Γ) := by
  constructor
  · intro h
    rw [← neg_mul, ← h, mul_assoc, G.Γ_mul_Γ, mul_one]
  · intro h
    rw [h, neg_mul, mul_assoc, G.Γ_mul_Γ, mul_one]

/-- Right multiplication by the grading unitary is injective. -/
lemma mul_Γ_injective : Function.Injective fun x : H →L[ℂ] H => x * G.Γ := fun x y h => by
  simpa [mul_assoc, G.Γ_mul_Γ] using congrArg (· * G.Γ) h

/-- **Every element of a local algebra is the sum of an even and an odd one in that algebra**:
    `x = (x + Γ x Γ) / 2 + (x - Γ x Γ) / 2`. -/
lemma exists_even_add_odd {O : K} {x : H →L[ℂ] H} (hx : x ∈ N.algebra O) :
    ∃ x₀ ∈ N.algebra O, ∃ x₁ ∈ N.algebra O,
      Commute G.Γ x₀ ∧ G.Γ * x₁ = -(x₁ * G.Γ) ∧ x₀ + x₁ = x := by
  have hΓx := G.Γ_mul_mul_Γ_mem hx
  have key : G.Γ * (G.Γ * x * G.Γ) * G.Γ = x := by simp [mul_assoc, G.Γ_mul_Γ]
  refine ⟨(2⁻¹ : ℂ) • (x + G.Γ * x * G.Γ), SMulMemClass.smul_mem _ (add_mem hx hΓx),
    (2⁻¹ : ℂ) • (x - G.Γ * x * G.Γ), SMulMemClass.smul_mem _ (sub_mem hx hΓx), ?_, ?_, ?_⟩
  · rw [← G.Γ_mul_mul_Γ_eq_self_iff, mul_smul_comm, smul_mul_assoc, mul_add, add_mul, key,
      add_comm]
  · rw [← G.Γ_mul_mul_Γ_eq_neg_iff, mul_smul_comm, smul_mul_assoc, mul_sub, sub_mul, key,
      ← smul_neg, neg_sub]
  · rw [← smul_add, add_add_sub_cancel, ← two_smul ℂ x, smul_smul, inv_mul_cancel₀ two_ne_zero,
      one_smul]

/-- The grading unitary, as a unitary. -/
lemma Γ_mem_unitary : G.Γ ∈ unitary (H →L[ℂ] H) :=
  Unitary.mem_iff.2 ⟨by rw [G.star_Γ, G.Γ_mul_Γ], by rw [G.star_Γ, G.Γ_mul_Γ]⟩

/-! ### The twist -/

private lemma smul_one_add_smul_mul (a b c d : ℂ) :
    (a • (1 : H →L[ℂ] H) + b • G.Γ) * (c • 1 + d • G.Γ) =
      (a * c + b * d) • (1 : H →L[ℂ] H) + (a * d + b * c) • G.Γ := by
  simp only [add_mul, mul_add, smul_mul_smul_comm, one_mul, mul_one, G.Γ_mul_Γ]
  module

/-- The operator `(1 - iΓ) / (1 - i)`, written `((1 + i) / 2) + ((1 - i) / 2) Γ`. -/
private lemma inv_one_sub_I_smul :
    ((1 - I)⁻¹ : ℂ) • (1 - I • G.Γ) = ((1 + I) / 2) • (1 : H →L[ℂ] H) + ((1 - I) / 2) • G.Γ := by
  have hinv : ((1 - I)⁻¹ : ℂ) = (1 + I) / 2 :=
    inv_eq_of_mul_eq_one_right (by linear_combination (-1 / 2 : ℂ) * I_sq)
  rw [hinv, smul_sub, smul_smul,
    show (1 + I) / 2 * I = -((1 - I) / 2) by linear_combination (1 / 2 : ℂ) * I_sq, neg_smul,
    sub_neg_eq_add]

private lemma star_inv_one_sub_I_smul :
    star (((1 - I)⁻¹ : ℂ) • (1 - I • G.Γ)) =
      ((1 - I) / 2) • (1 : H →L[ℂ] H) + ((1 + I) / 2) • G.Γ := by
  rw [G.inv_one_sub_I_smul, star_add, star_smul, star_smul, star_one, G.star_Γ]
  congr 2 <;> simp [Complex.ext_iff]

/-- The operator `(1 - iΓ) / (1 - i)` is unitary. -/
lemma inv_one_sub_I_smul_mem_unitary :
    ((1 - I)⁻¹ : ℂ) • (1 - I • G.Γ) ∈ unitary (H →L[ℂ] H) := by
  rw [Unitary.mem_iff, G.star_inv_one_sub_I_smul, G.inv_one_sub_I_smul, G.smul_one_add_smul_mul,
    G.smul_one_add_smul_mul,
    show (1 - I) / 2 * ((1 + I) / 2) + (1 + I) / 2 * ((1 - I) / 2) = 1 by
      linear_combination (-1 / 2 : ℂ) * I_sq,
    show (1 - I) / 2 * ((1 - I) / 2) + (1 + I) / 2 * ((1 + I) / 2) = 0 by
      linear_combination (1 / 2 : ℂ) * I_sq,
    show (1 + I) / 2 * ((1 - I) / 2) + (1 - I) / 2 * ((1 + I) / 2) = 1 by
      linear_combination (-1 / 2 : ℂ) * I_sq,
    show (1 + I) / 2 * ((1 + I) / 2) + (1 - I) / 2 * ((1 - I) / 2) = 0 by
      linear_combination (1 / 2 : ℂ) * I_sq]
  simp

/-- The **twist** `Z = (1 - iΓ) / (1 - i)` of a grading, a unitary: it acts as `1` on the even
    vectors and as `i` on the odd ones. -/
noncomputable def twist : unitary (H →L[ℂ] H) :=
  ⟨((1 - I)⁻¹ : ℂ) • (1 - I • G.Γ), G.inv_one_sub_I_smul_mem_unitary⟩

/-- The twist is `(1 - iΓ) / (1 - i)`. -/
lemma coe_twist : (G.twist : H →L[ℂ] H) = ((1 - I)⁻¹ : ℂ) • (1 - I • G.Γ) := rfl

/-- The twist is `((1 + i) / 2) + ((1 - i) / 2) Γ`. -/
lemma coe_twist_eq :
    (G.twist : H →L[ℂ] H) = ((1 + I) / 2) • (1 : H →L[ℂ] H) + ((1 - I) / 2) • G.Γ :=
  G.inv_one_sub_I_smul

/-- **The twist fixes the even operators**: `Z y Z⋆ = y` when `y` commutes with `Γ`. -/
lemma twist_mul_mul_star_of_commute {y : H →L[ℂ] H} (hy : Commute G.Γ y) :
    (G.twist : H →L[ℂ] H) * y * star (G.twist : H →L[ℂ] H) = y := by
  have hZ : Commute (G.twist : H →L[ℂ] H) y := by
    rw [G.coe_twist_eq]
    exact ((Commute.one_left y).smul_left _).add_left (hy.smul_left _)
  rw [hZ.eq, mul_assoc, Unitary.mul_star_self_of_mem G.twist.2, mul_one]

/-- **The twist multiplies the odd operators by `iΓ`**: `Z y Z⋆ = i y Γ` when `y` anticommutes with
    `Γ`. -/
lemma twist_mul_mul_star_of_anticommute {y : H →L[ℂ] H} (hy : G.Γ * y = -(y * G.Γ)) :
    (G.twist : H →L[ℂ] H) * y * star (G.twist : H →L[ℂ] H) = I • (y * G.Γ) := by
  have h₁ : (G.twist : H →L[ℂ] H) * y = y * (((1 + I) / 2) • 1 + (-((1 - I) / 2)) • G.Γ) := by
    rw [G.coe_twist_eq, add_mul, mul_add, smul_mul_assoc, smul_mul_assoc, one_mul, hy,
      mul_smul_comm, mul_smul_comm, mul_one, neg_smul, smul_neg]
  have h₂ : star (G.twist : H →L[ℂ] H) = ((1 - I) / 2) • (1 : H →L[ℂ] H) + ((1 + I) / 2) • G.Γ :=
    G.star_inv_one_sub_I_smul
  rw [h₁, mul_assoc, h₂, G.smul_one_add_smul_mul,
    show (1 + I) / 2 * ((1 - I) / 2) + -((1 - I) / 2) * ((1 + I) / 2) = 0 by ring,
    show (1 + I) / 2 * ((1 + I) / 2) + -((1 - I) / 2) * ((1 - I) / 2) = I by
      linear_combination (0 : ℂ) * I_sq,
    zero_smul, zero_add, mul_smul_comm]

/-- The adjoint action of the twist is conjugation by the twist: `Z y Z⋆`. -/
lemma conjStarAlgEquiv_twist (y : H →L[ℂ] H) :
    (Unitary.linearIsometryEquiv G.twist).conjStarAlgEquiv y =
      (G.twist : H →L[ℂ] H) * y * star (G.twist : H →L[ℂ] H) := by
  rw [Unitary.conjStarAlgEquiv_unitaryLinearIsometryEquiv, Unitary.conjStarAlgAut_apply]

/-- **The graded commutation relations give twisted commutation**: if `x₀ + x₁` and `y₀ + y₁` are
    split into even parts `x₀`, `y₀` and odd parts `x₁`, `y₁`, every pair of parts commuting except
    the two odd ones, which anticommute, then `x₀ + x₁` commutes with `Z (y₀ + y₁) Z⋆`. -/
lemma commute_twist_mul_mul_star {x₀ x₁ y₀ y₁ : H →L[ℂ] H} (hx₀ : Commute G.Γ x₀)
    (hx₁ : G.Γ * x₁ = -(x₁ * G.Γ)) (hy₀ : Commute G.Γ y₀) (hy₁ : G.Γ * y₁ = -(y₁ * G.Γ))
    (h₀₀ : Commute x₀ y₀) (h₀₁ : Commute x₀ y₁) (h₁₀ : Commute x₁ y₀)
    (h₁₁ : x₁ * y₁ = -(y₁ * x₁)) :
    Commute (x₀ + x₁) ((G.twist : H →L[ℂ] H) * (y₀ + y₁) * star (G.twist : H →L[ℂ] H)) := by
  rw [mul_add, add_mul, G.twist_mul_mul_star_of_commute hy₀,
    G.twist_mul_mul_star_of_anticommute hy₁]
  have hx₁' : x₁ * G.Γ = -(G.Γ * x₁) := by rw [hx₁, neg_neg]
  have h₁₁' : Commute x₁ (y₁ * G.Γ) :=
    calc x₁ * (y₁ * G.Γ) = -(y₁ * (x₁ * G.Γ)) := by rw [← mul_assoc, h₁₁, neg_mul, mul_assoc]
      _ = y₁ * G.Γ * x₁ := by rw [hx₁', mul_neg, neg_neg, mul_assoc]
  exact (h₀₀.add_right ((h₀₁.mul_right hx₀.symm).smul_right I)).add_left
    (h₁₀.add_right (h₁₁'.smul_right I))

/-! ### Graded locality -/

variable [CausalOrthogonality K]

/-- **Graded locality** of a net of von Neumann algebras with a grading (Carpi–Kawahigashi–Longo,
    2008, §2.1): for causally orthogonal regions, an even element of the one commutes with every
    element of the other (`locality_even`) and two odd elements anticommute (`locality_odd`); that
    is, their graded commutator vanishes. -/
structure IsGradedLocal : Prop where
  /-- **Graded locality**, even elements: an even element of `𝓡(O₁)` commutes with every element
      of `𝓡(O₂)` for `O₁ ⟂ O₂`. -/
  locality_even : ∀ ⦃O₁ O₂ : K⦄, O₁ ⟂ O₂ → ∀ ⦃x y : H →L[ℂ] H⦄, x ∈ N.algebra O₁ →
      y ∈ N.algebra O₂ → G.Γ * x * G.Γ = x → Commute x y
  /-- **Graded locality**, odd elements: odd elements of `𝓡(O₁)` and `𝓡(O₂)` anticommute for
      `O₁ ⟂ O₂`. -/
  locality_odd : ∀ ⦃O₁ O₂ : K⦄, O₁ ⟂ O₂ → ∀ ⦃x y : H →L[ℂ] H⦄, x ∈ N.algebra O₁ →
      y ∈ N.algebra O₂ → G.Γ * x * G.Γ = -x → G.Γ * y * G.Γ = -y → x * y = -(y * x)

/-- **Graded locality is twisted commutation**: the grading `G` makes the net graded-local iff,
    for causally orthogonal regions, every `x ∈ 𝓡(O₁)` commutes with `Z y Z⋆` for every
    `y ∈ 𝓡(O₂)`. -/
lemma isGradedLocal_iff_commute_twist :
    G.IsGradedLocal ↔ ∀ ⦃O₁ O₂ : K⦄, O₁ ⟂ O₂ → ∀ ⦃x y : H →L[ℂ] H⦄, x ∈ N.algebra O₁ →
      y ∈ N.algebra O₂ →
        Commute x ((G.twist : H →L[ℂ] H) * y * star (G.twist : H →L[ℂ] H)) := by
  constructor
  · intro hG O₁ O₂ hd x y hx hy
    obtain ⟨x₀, hx₀, x₁, hx₁, hx₀e, hx₁o, rfl⟩ := G.exists_even_add_odd hx
    obtain ⟨y₀, hy₀, y₁, hy₁, hy₀e, hy₁o, rfl⟩ := G.exists_even_add_odd hy
    have even {z : H →L[ℂ] H} (hz : Commute G.Γ z) : G.Γ * z * G.Γ = z :=
      G.Γ_mul_mul_Γ_eq_self_iff.2 hz
    exact G.commute_twist_mul_mul_star hx₀e hx₁o hy₀e hy₁o
      (hG.locality_even hd hx₀ hy₀ (even hx₀e)) (hG.locality_even hd hx₀ hy₁ (even hx₀e))
      (hG.locality_even hd.symm hy₀ hx₁ (even hy₀e)).symm
      (hG.locality_odd hd hx₁ hy₁ (G.Γ_mul_mul_Γ_eq_neg_iff.2 hx₁o)
        (G.Γ_mul_mul_Γ_eq_neg_iff.2 hy₁o))
  · intro h
    have odd_part {x y : H →L[ℂ] H} (hy : G.Γ * y = -(y * G.Γ))
        (hxy : Commute x ((G.twist : H →L[ℂ] H) * y * star (G.twist : H →L[ℂ] H))) :
        x * y * G.Γ = y * G.Γ * x := by
      rw [G.twist_mul_mul_star_of_anticommute hy] at hxy
      have := (hxy.smul_right (-I)).eq
      rwa [smul_smul, neg_mul, I_mul_I, neg_neg, one_smul, ← mul_assoc] at this
    refine ⟨fun O₁ O₂ hd x y hx hy hxe => ?_, fun O₁ O₂ hd x y hx hy hxo hyo => ?_⟩
    · obtain ⟨y₀, hy₀, y₁, hy₁, hy₀e, hy₁o, rfl⟩ := G.exists_even_add_odd hy
      have hΓx : Commute G.Γ x := G.Γ_mul_mul_Γ_eq_self_iff.1 hxe
      refine Commute.add_right ?_ ?_
      · simpa [G.twist_mul_mul_star_of_commute hy₀e] using h hd hx hy₀
      · refine G.mul_Γ_injective ?_
        change x * y₁ * G.Γ = y₁ * x * G.Γ
        rw [odd_part hy₁o (h hd hx hy₁), mul_assoc, hΓx.eq, mul_assoc]
    · refine G.mul_Γ_injective ?_
      change x * y * G.Γ = -(y * x) * G.Γ
      rw [odd_part (G.Γ_mul_mul_Γ_eq_neg_iff.1 hyo) (h hd hx hy), mul_assoc,
        ← neg_neg (G.Γ * x), G.Γ_mul_mul_Γ_eq_neg_iff.1 hxo, neg_neg, mul_neg, neg_mul, mul_assoc]

/-- **Graded locality is twisted locality**: the grading `G` makes the net graded-local iff
    `𝓡(O₁) ≤ Z 𝓡(O₂)′ Z⋆` for all causally orthogonal regions, with the twist
    `Z = (1 - iΓ) / (1 - i)` of Carpi–Kawahigashi–Longo (2008, §2.1). -/
theorem isGradedLocal_iff_le_conj_commutant :
    G.IsGradedLocal ↔ ∀ ⦃O₁ O₂ : K⦄, O₁ ⟂ O₂ →
      N.algebra O₁ ≤ VonNeumannAlgebra.conj (Unitary.linearIsometryEquiv G.twist) (N.algebra O₂)′ := by
  rw [isGradedLocal_iff_commute_twist]
  refine forall₃_congr fun O₁ O₂ _ => ⟨fun h x hx => ?_, fun h x y hx hy => ?_⟩
  · refine (VonNeumannAlgebra.mem_conj_commutant_iff _ _).2 fun y hy => ?_
    rw [conjStarAlgEquiv_twist]
    exact h hx hy
  · have := (VonNeumannAlgebra.mem_conj_commutant_iff _ _).1 (h hx) y hy
    rwa [conjStarAlgEquiv_twist] at this

/-- **Graded locality of a net generated by sets of operators** is checked on the generators: if
    `𝓡(O) = s(O)″` and, for causally orthogonal regions, every generator `x ∈ s(O₁)` commutes with
    `Z y Z⋆` and `Z y⋆ Z⋆` for every generator `y ∈ s(O₂)`, the net is graded-local. -/
lemma isGradedLocal_of_generated (s : K → Set (H →L[ℂ] H))
    (hs : ∀ O, N.algebra O = VonNeumannAlgebra.generated (s O))
    (h : ∀ ⦃O₁ O₂ : K⦄, O₁ ⟂ O₂ → ∀ x ∈ s O₁, ∀ y ∈ s O₂,
      Commute x ((G.twist : H →L[ℂ] H) * y * star (G.twist : H →L[ℂ] H)) ∧
        Commute x ((G.twist : H →L[ℂ] H) * star y * star (G.twist : H →L[ℂ] H))) :
    G.IsGradedLocal := by
  refine G.isGradedLocal_iff_le_conj_commutant.2 fun O₁ O₂ hd => ?_
  rw [hs, hs]
  refine VonNeumannAlgebra.generated_le_conj_commutant_generated _ fun x hx y hy => ?_
  rw [conjStarAlgEquiv_twist, conjStarAlgEquiv_twist]
  exact h hd x hx y hy

end Grading

/-! ### Local nets -/

variable [CausalOrthogonality K]

/-- A net of von Neumann algebras is **local** when causally orthogonal regions carry commuting
    algebras: `𝓡(O₁) ≤ 𝓡(O₂)′` for `O₁ ⟂ O₂` (Einstein causality). This is graded locality for the
    trivial grading (`VonNeumannNet.Grading.isGradedLocal_trivial_iff`). It is the commutation
    itself, unlike `GradedLocalNet.IsLocal`, which asks the parity of a graded-local net of
    C⋆-algebras to be trivial. -/
class IsLocal (N : VonNeumannNet K H) : Prop where
  /-- **Locality**: causally orthogonal regions carry commuting algebras. -/
  algebra_le_commutant_of_orthogonal : ∀ ⦃O₁ O₂ : K⦄, O₁ ⟂ O₂ → N.algebra O₁ ≤ (N.algebra O₂)′

/-- **Locality** (microcausality) of a local net: `𝓡(O₁) ≤ 𝓡(O₂)′` for `O₁ ⟂ O₂`. -/
lemma algebra_le_commutant_of_orthogonal (N : VonNeumannNet K H) [N.IsLocal] {O₁ O₂ : K}
    (h : O₁ ⟂ O₂) : N.algebra O₁ ≤ (N.algebra O₂)′ :=
  IsLocal.algebra_le_commutant_of_orthogonal h

/-- **For the trivial grading, graded locality is locality**: every operator is even, so graded
    locality asks the algebras of causally orthogonal regions to commute, and no operator other
    than `0` is odd. -/
theorem Grading.isGradedLocal_trivial_iff {N : VonNeumannNet K H} :
    (Grading.trivial N).IsGradedLocal ↔ N.IsLocal := by
  refine ⟨fun h => ⟨fun O₁ O₂ hd x hx => VonNeumannAlgebra.mem_commutant_iff.2 fun y hy =>
    (h.locality_even hd hx hy (by simp)).eq.symm⟩, fun h => ⟨?_, ?_⟩⟩
  · intro O₁ O₂ hd x y hx hy _
    exact (VonNeumannAlgebra.mem_commutant_iff.1 (N.algebra_le_commutant_of_orthogonal hd hx) y
      hy).symm
  · intro O₁ O₂ hd x y hx hy hxo _
    have hx0 : x = 0 := by
      have h2 : (2 : ℂ) • x = 0 := by
        rw [two_smul]
        exact eq_neg_iff_add_eq_zero.mp (by simpa using hxo)
      exact (smul_eq_zero.mp h2).resolve_left two_ne_zero
    simp [hx0]

end VonNeumannNet
