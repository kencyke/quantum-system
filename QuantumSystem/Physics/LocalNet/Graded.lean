module

public import QuantumSystem.Analysis.CStarAlgebra.DynamicalSystem
public import QuantumSystem.Physics.LocalNet.QuasiLocalAlgebra

/-!
# Graded-local nets: the even subnet and nets of subalgebras

A graded-local net (`GradedLocalNet`, defined in `QuantumSystem.Physics.LocalNet.Basic`) carries a
parity automorphism of every local algebra, and its locality is graded: even elements of causally
orthogonal regions commute with everything, odd ones anticommute. This is the net of a system with
fermions. Two constructions relate it to local nets and to the form in which such nets are usually
given.

* The **even subnet** (Bose subnet) `GradedLocalNet.even`: the even elements of every local algebra
  form a C⋆-subalgebra `GradedLocalNet.evenPart`, the fixed points of the parity, and these
  subalgebras form a `LocalNet`: on even elements graded locality is commutation. It is faithful
  when the net is. For a faithful net over a directed index set, the even part of the quasi-local
  algebra `GradedLocalNet.quasiLocalEvenPart` — the fixed points of the action of `ℤ₂` generated by
  the quasi-local parity — is the closure of the even local algebras
  (`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`).
* A **net of subalgebras** `GradedLocalNet.ofStarSubalgebras`: an increasing family of closed
  ⋆-subalgebras `S O` of one C⋆-algebra `A`, invariant under an involutive ⋆-automorphism `Θ` of
  `A`, is a graded-local net as soon as the elements of `S O₁` and `S O₂` graded-commute in `A` for
  causally orthogonal `O₁`, `O₂`. No common upper bound of the two regions is needed, the ambient
  algebra being where the commutation is stated. The net is faithful.

## Main definitions

* `GradedLocalNet.evenPart N O` — the C⋆-subalgebra of the even elements of `𝔄(O)`.
* `GradedLocalNet.even N` — the even subnet, a `LocalNet`.
* `GradedLocalNet.quasiLocalEvenPart N` — the C⋆-subalgebra of the even elements of the quasi-local
  algebra.
* `GradedLocalNet.ofStarSubalgebras S hS Θ …` — the graded-local net of an increasing family of
  `Θ`-invariant closed ⋆-subalgebras.

## Main results

* `GradedLocalNet.mem_evenPart` — an element is in the even part iff the parity fixes it.
* `GradedLocalNet.instFaithfulEven` — the even subnet of a faithful net is faithful.
* `GradedLocalNet.ιLocalCStar_mem_quasiLocalEvenPart_iff` — a local observable is even in the
  quasi-local algebra iff it is even locally.
* **`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`** — the even part of the
  quasi-local algebra is generated by the even subnet.
* `GradedLocalNet.instFaithfulOfStarSubalgebras` — a net of subalgebras is faithful.
-/

@[expose] public section

open scoped CausalOrthogonality

namespace GradedLocalNet

variable {K : Type*} [Preorder K] [CausalOrthogonality K]

/-! ### The even subnet -/

section Even

variable (N : GradedLocalNet K)

/-- The **even part** of a local algebra: the C⋆-subalgebra of the elements fixed by the parity,
    the fixed-point algebra (`StarAlgEquiv.fixedPoints`) of the action of the grading group `ℤ₂`
    the parity generates (`StarAlgEquiv.involutionHom`). -/
noncomputable def evenPart (O : K) : StarSubalgebra ℂ (N.algebra O) :=
  StarAlgEquiv.fixedPoints (StarAlgEquiv.involutionHom (N.parity O)
    (StarAlgEquiv.ext fun x => N.parity_parity x))

/-- An element is even iff the parity fixes it. -/
@[simp] lemma mem_evenPart {O : K} {x : N.algebra O} : x ∈ N.evenPart O ↔ N.parity O x = x :=
  StarAlgEquiv.mem_fixedPoints_involutionHom

/-- The even part is closed, so it is a C⋆-algebra. -/
instance instIsClosedEvenPart (O : K) : IsClosed (N.evenPart O : Set (N.algebra O)) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- The isotony embedding of the even parts: the restriction of `incl`, which preserves the
    parity. -/
noncomputable def evenIncl {O O' : K} (h : O ≤ O') : N.evenPart O →⋆ₐ[ℂ] N.evenPart O' :=
  ((N.incl h).comp (N.evenPart O).subtype).codRestrict (N.evenPart O') fun x =>
    N.mem_evenPart.mpr <| by
      change N.parity O' (N.incl h x) = N.incl h x
      rw [N.parity_incl, N.mem_evenPart.mp x.2]

/-- The restricted isotony embedding acts as `incl`. -/
@[simp] lemma coe_evenIncl {O O' : K} (h : O ≤ O') (x : N.evenPart O) :
    (N.evenIncl h x : N.algebra O') = N.incl h (x : N.algebra O) :=
  rfl

/-- The **even subnet** (Bose subnet) of a graded-local net: the even parts of the local algebras,
    with the restricted isotony embeddings. It is a `LocalNet`: for even elements graded locality is
    commutation. -/
noncomputable def even : LocalNet K :=
  LocalNet.ofLocality (fun O => N.evenPart O) (fun h => N.evenIncl h)
    (fun x => Subtype.ext (N.incl_refl x.1))
    (fun h₁₂ h₂₃ x => Subtype.ext (N.incl_trans h₁₂ h₂₃ x.1))
    (fun h₁ h₂ hd x y => Subtype.ext
      (N.locality_even h₁ h₂ hd x.1 y.1 (N.mem_evenPart.mp x.2)).eq)

/-- The local algebras of the even subnet are the even parts. -/
lemma even_algebra (O : K) : N.even.algebra O = N.evenPart O :=
  rfl

/-- The isotony embeddings of the even subnet are the restricted ones. -/
lemma even_incl {O O' : K} (h : O ≤ O') : N.even.incl h = N.evenIncl h :=
  rfl

/-- The even subnet of a faithful net is faithful: its isotony embeddings are restrictions of
injective ones. -/
instance instFaithfulEven [N.Faithful] : N.even.Faithful where
  incl_injective h _ _ hxy := Subtype.ext (Faithful.incl_injective (N := N) h (congrArg Subtype.val hxy))

end Even

/-! ### The even part of the quasi-local algebra -/

section QuasiLocalEven

variable [IsDirectedOrder K] [Nonempty K] (N : GradedLocalNet K) [N.Faithful]

/-- The quasi-local parity generates an action of `ℤ₂`. -/
lemma quasiLocalParity_mul_self : N.quasiLocalParity * N.quasiLocalParity = 1 :=
  StarAlgEquiv.ext N.quasiLocalParity_quasiLocalParity

/-- The **even part of the quasi-local algebra** (the Bose algebra): the fixed-point algebra
(`StarAlgEquiv.fixedPoints`) of the action of `ℤ₂` generated by the quasi-local parity
(`StarAlgEquiv.involutionHom`). It is generated by the even subnet
(`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`). -/
noncomputable def quasiLocalEvenPart : StarSubalgebra ℂ N.quasiLocalCStarAlgebra :=
  StarAlgEquiv.fixedPoints (StarAlgEquiv.involutionHom N.quasiLocalParity N.quasiLocalParity_mul_self)

/-- An element of the quasi-local algebra is even iff the quasi-local parity fixes it. -/
@[simp] lemma mem_quasiLocalEvenPart {z : N.quasiLocalCStarAlgebra} :
    z ∈ N.quasiLocalEvenPart ↔ N.quasiLocalParity z = z :=
  StarAlgEquiv.mem_fixedPoints_involutionHom

/-- The even part of the quasi-local algebra is closed, so it is a C⋆-algebra. -/
instance instIsClosedQuasiLocalEvenPart : IsClosed (N.quasiLocalEvenPart : Set N.quasiLocalCStarAlgebra) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- A local observable is even in the quasi-local algebra iff it is even in its local algebra. -/
lemma ιLocalCStar_mem_quasiLocalEvenPart_iff {O : K} {x : N.algebra O} :
    N.ιLocalCStar O x ∈ N.quasiLocalEvenPart ↔ x ∈ N.evenPart O := by
  rw [mem_quasiLocalEvenPart, quasiLocalParity_ιLocalCStar, mem_evenPart]
  exact (N.ιLocalCStar_injective O).eq_iff

/-- The even part `(x + Θ x) / 2` of a local observable, in the even subnet. -/
private noncomputable def evenProj {O : K} (x : N.algebra O) : N.even.algebra O :=
  ⟨(1 / 2 : ℂ) • (x + N.parity O x), N.mem_evenPart.mpr <| by
    rw [map_smul, map_add, N.parity_parity, add_comm]⟩

/-- **The even part of the quasi-local algebra is generated by the even subnet**: it is the closure
of the union of the even local algebras, embedded by the local embeddings of `N`. An even element
`z` is the limit of the even parts `(y + Θ y) / 2` of local observables `y → z`. -/
theorem closure_iUnion_range_even_eq_quasiLocalEvenPart :
    closure (⋃ O : K, Set.range fun x : N.even.algebra O =>
      N.ιLocalCStar O ((N.evenPart O).subtype x)) = N.quasiLocalEvenPart := by
  refine (closure_minimal ?_ (instIsClosedQuasiLocalEvenPart N)).antisymm fun z hz => ?_
  · rintro _ ⟨-, ⟨O, rfl⟩, x, rfl⟩
    exact N.ιLocalCStar_mem_quasiLocalEvenPart_iff.mpr x.2
  · let P : N.quasiLocalCStarAlgebra → N.quasiLocalCStarAlgebra :=
      fun w => (1 / 2 : ℂ) • (w + N.quasiLocalParity w)
    have hP : Continuous P :=
      (continuous_id.add (StarAlgEquiv.isometry N.quasiLocalParity).continuous).const_smul
        (1 / 2 : ℂ)
    have hz' : P z = z := by
      simp only [P, N.mem_quasiLocalEvenPart.mp hz]
      rw [← two_smul ℂ z, smul_smul]
      norm_num
    rw [← hz']
    refine closure_mono ?_ (image_closure_subset_closure_image hP
      ⟨z, N.denseRange_iUnion_ιLocalCStar.closure_eq ▸ Set.mem_univ z, rfl⟩)
    rintro _ ⟨-, ⟨-, ⟨O, rfl⟩, y, rfl⟩, rfl⟩
    refine Set.mem_iUnion.mpr ⟨O, N.evenProj y, ?_⟩
    simp only [evenProj, P, quasiLocalParity_ιLocalCStar]
    change N.ιLocalCStar O ((1 / 2 : ℂ) • (y + N.parity O y)) = _
    rw [map_smul, map_add]

end QuasiLocalEven

/-! ### Nets of subalgebras -/

section OfStarSubalgebras

variable {A : Type*} [CStarAlgebra A]

/-- The **graded-local net of a family of subalgebras**: an increasing family `S` of closed
    ⋆-subalgebras of a C⋆-algebra `A`, each invariant under an involutive ⋆-automorphism `Θ` of `A`
    (the parity), such that for causally orthogonal regions an even element of `S O₁` commutes with
    every element of `S O₂` and odd elements of the two anticommute. The local algebras are the
    `S O`, the isotony embeddings are the inclusions and the parity is the restriction of `Θ`. This
    is the form in which the net of a fermion system is given: the subalgebras of the CAR algebra
    generated by the creation and annihilation operators of a region. -/
noncomputable def ofStarSubalgebras (S : K → StarSubalgebra ℂ A) (hS : Monotone S)
    [hclosed : ∀ O, IsClosed (S O : Set A)] (Θ : A ≃⋆ₐ[ℂ] A) (hΘ : ∀ a, Θ (Θ a) = a)
    (hΘS : ∀ O, ∀ a ∈ S O, Θ a ∈ S O)
    (h_even : ∀ {O₁ O₂ : K}, O₁ ⟂ O₂ → ∀ a ∈ S O₁, ∀ b ∈ S O₂, Θ a = a → Commute a b)
    (h_odd : ∀ {O₁ O₂ : K}, O₁ ⟂ O₂ → ∀ a ∈ S O₁, ∀ b ∈ S O₂, Θ a = -a → Θ b = -b →
      a * b = -(b * a)) :
    GradedLocalNet K where
  algebra O := S O
  incl h := StarSubalgebra.inclusion (hS h)
  incl_refl _ := rfl
  incl_trans _ _ _ := rfl
  parity O := StarAlgEquiv.restrict Θ (S O) (hΘS O) fun a ha => by
    rw [show Θ.symm a = Θ a by rw [← hΘ (Θ.symm a), Θ.apply_symm_apply]]
    exact hΘS O a ha
  parity_parity x := Subtype.ext (hΘ x)
  parity_incl _ _ := rfl
  locality_even _ _ hd x y hx :=
    Subtype.ext (h_even hd x x.2 y y.2 (congrArg Subtype.val hx))
  locality_odd _ _ hd x y hx hy :=
    Subtype.ext (h_odd hd x x.2 y y.2 (congrArg Subtype.val hx) (congrArg Subtype.val hy))

/-- A net of subalgebras is faithful: its isotony embeddings are inclusions. -/
instance instFaithfulOfStarSubalgebras (S : K → StarSubalgebra ℂ A) (hS : Monotone S)
    [∀ O, IsClosed (S O : Set A)] (Θ : A ≃⋆ₐ[ℂ] A) (hΘ : ∀ a, Θ (Θ a) = a)
    (hΘS : ∀ O, ∀ a ∈ S O, Θ a ∈ S O)
    (h_even : ∀ {O₁ O₂ : K}, O₁ ⟂ O₂ → ∀ a ∈ S O₁, ∀ b ∈ S O₂, Θ a = a → Commute a b)
    (h_odd : ∀ {O₁ O₂ : K}, O₁ ⟂ O₂ → ∀ a ∈ S O₁, ∀ b ∈ S O₂, Θ a = -a → Θ b = -b →
      a * b = -(b * a)) :
    (ofStarSubalgebras S hS Θ hΘ hΘS h_even h_odd).Faithful where
  incl_injective h := StarSubalgebra.inclusion_injective (hS h)

end OfStarSubalgebras

end GradedLocalNet
