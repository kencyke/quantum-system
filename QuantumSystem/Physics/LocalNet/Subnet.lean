module

public import QuantumSystem.Analysis.CStarAlgebra.DynamicalSystem
public import QuantumSystem.Physics.LocalNet.Automorphism.QuasiLocal

/-!
# Subnets of a net

Subnets of a graded-local net (`GradedLocalNet`, defined in
`QuantumSystem.Physics.LocalNet.Basic`): nets of C⋆-subalgebras of its local algebras, with the
restricted isotony embeddings and the restricted parity. A family of closed `*`-subalgebras that
the isotony embeddings carry into one another and the parity preserves forms a graded-local net
(`GradedLocalNet.restrict`), and both subnets here are of that form. There is no relation recording
that one net sits inside another, and no covariance condition on it; each construction returns a
`GradedLocalNet` of its own, whose algebras are the subalgebras by definition
(`GradedLocalNet.fixedPointNet_algebra`, `GradedLocalNet.even_algebra`). Nor is there a subnet of a
net of von Neumann algebras, which a net over a non-directed index set needs for its locality.

* The **fixed-point subnet** `GradedLocalNet.fixedPointNet N α` of a monoid `G` of internal
  symmetries, acting through `α : G →* GradedLocalNet.Automorphism.internal N` by the automorphisms
  of the net that leave every region in place: the fixed points of the local algebras form a
  graded-local net, the automorphisms commuting with the parity, and a local one when `N` is local
  (`GradedLocalNet.instIsTriviallyGradedFixedPointNet`). The acting monoid is arbitrary: neither a
  group nor compactness is assumed.
* The **even subnet** (Bose subnet) `GradedLocalNet.even`: the even elements of every local algebra
  form a C⋆-subalgebra `GradedLocalNet.evenPart`, the fixed points of the parity symmetry
  (`GradedLocalNet.paritySymmetry`, `GradedLocalNet.fixedPart_paritySymmetry`), and these
  subalgebras form a local net. It is faithful when the net is. For a faithful net over a directed
  index set, the even part of the quasi-local algebra `GradedLocalNet.quasiLocalEvenPart` — the
  fixed points of the action of `ℤ₂` generated by the quasi-local parity — is the closure of the
  even local algebras (`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`).

A graded-local net with a non-trivial parity is the net of two Majorana modes
(`VonNeumannNet.Examples.majoranaGradedLocalNet`).

## Main definitions

* `GradedLocalNet.restrict N S hincl hpar` — the subnet of a family of invariant C⋆-subalgebras.
* `GradedLocalNet.fixedPart α O`, `GradedLocalNet.fixedPointNet N α` — the fixed points of a monoid
  of internal symmetries and its fixed-point subnet.
* `GradedLocalNet.paritySymmetry N` — the action of `ℤ₂` generated by the parity, by internal
  automorphisms.
* `GradedLocalNet.evenPart N O` — the C⋆-subalgebra of the even elements of `𝔄(O)`.
* `GradedLocalNet.even N` — the even subnet, a local net.
* `GradedLocalNet.quasiLocalEvenPart N` — the C⋆-subalgebra of the even elements of the quasi-local
  algebra.

## Main results

* `GradedLocalNet.mem_evenPart` — an element is in the even part iff the parity fixes it.
* `GradedLocalNet.instFaithfulEven` — the even subnet of a faithful net is faithful.
* `GradedLocalNet.ιLocalCStar_mem_quasiLocalEvenPart_iff` — a local observable is even in the
  quasi-local algebra iff it is even locally.
* **`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`** — the even part of the
  quasi-local algebra is generated by the even subnet.

## Notation

`𝔄(O)` in the prose is documentation shorthand for the local C⋆-algebra `N.algebra O`; the
convention is stated in full in `QuantumSystem.Physics.LocalNet.Isotony`.
`Θ` is the quasi-local parity `N.quasiLocalParity`.
-/

@[expose] public section

open scoped CausalOrthogonality

namespace GradedLocalNet

variable {K : Type*} [Preorder K] [CausalOrthogonality K]

/-! ### The subnet of invariant subalgebras -/

section Restrict

variable (N : GradedLocalNet K)

/-- The parity of a local algebra is its own inverse. -/
lemma parity_symm_apply (O : K) (x : N.algebra O) : (N.parity O).symm x = N.parity O x :=
  (StarAlgEquiv.symm_apply_eq _).2 (N.parity_parity x).symm

/-- **The subnet of a family of invariant C⋆-subalgebras**: closed `*`-subalgebras `S O` of the
local algebras that the isotony embeddings carry into one another and the parity preserves form a
graded-local net, with the restricted isotony embeddings and the restricted parity, the relations
of graded locality holding already in `N`. The fixed-point subnet of an internal symmetry
(`GradedLocalNet.fixedPointNet`) and the even subnet (`GradedLocalNet.even`) are of this form. -/
noncomputable def restrict (S : ∀ O, StarSubalgebra ℂ (N.algebra O))
    [∀ O, IsClosed (S O : Set (N.algebra O))]
    (hincl : ∀ ⦃O O' : K⦄ (h : O ≤ O') (x : N.algebra O), x ∈ S O → N.incl h x ∈ S O')
    (hpar : ∀ O, ∀ x ∈ S O, N.parity O x ∈ S O) : GradedLocalNet K where
  algebra O := S O
  incl h := ((N.incl h).comp (S _).subtype).codRestrict (S _) fun x => hincl h x x.2
  incl_refl x := Subtype.ext (N.incl_refl x.1)
  incl_trans h₁₂ h₂₃ x := Subtype.ext (N.incl_trans h₁₂ h₂₃ x.1)
  parity O := StarAlgEquiv.restrict (N.parity O) (S O) (hpar O)
    fun x hx => N.parity_symm_apply O x ▸ hpar O x hx
  parity_parity x := Subtype.ext (N.parity_parity x.1)
  parity_incl h x := Subtype.ext (N.parity_incl h x.1)
  locality_even h₁ h₂ hd x y hx :=
    Subtype.ext (N.locality_even h₁ h₂ hd x.1 y.1 (congrArg Subtype.val hx)).eq
  locality_odd h₁ h₂ hd x y hx hy :=
    Subtype.ext (N.locality_odd h₁ h₂ hd x.1 y.1 (congrArg Subtype.val hx) (congrArg Subtype.val hy))

variable {S : ∀ O, StarSubalgebra ℂ (N.algebra O)} [∀ O, IsClosed (S O : Set (N.algebra O))]
  {hincl : ∀ ⦃O O' : K⦄ (h : O ≤ O') (x : N.algebra O), x ∈ S O → N.incl h x ∈ S O'}
  {hpar : ∀ O, ∀ x ∈ S O, N.parity O x ∈ S O}

/-- The local algebras of the subnet are the given subalgebras. -/
lemma restrict_algebra (O : K) : (N.restrict S hincl hpar).algebra O = S O :=
  rfl

/-- The isotony embeddings of the subnet act as those of `N`. -/
@[simp] lemma coe_restrict_incl {O O' : K} (h : O ≤ O') (x : S O) :
    (show S O' from (N.restrict S hincl hpar).incl h x).val = N.incl h (x : N.algebra O) :=
  rfl

/-- **The subnet is local when the subalgebras are even**: its parity is then the identity. -/
lemma isTriviallyGraded_restrict (heven : ∀ O, ∀ x ∈ S O, N.parity O x = x) :
    (N.restrict S hincl hpar).IsTriviallyGraded :=
  ⟨fun x => Subtype.ext (heven _ x.1 x.2)⟩

/-- The subnet of a faithful net is faithful: its isotony embeddings are restrictions of injective
ones. -/
instance instFaithfulRestrict [N.Faithful] : (N.restrict S hincl hpar).Faithful where
  incl_injective h _ _ hxy :=
    Subtype.ext (CStarNet.Faithful.incl_injective (N := N.toCStarNet) h (congrArg Subtype.val hxy))

end Restrict

/-! ### The fixed-point subnet of a group of internal symmetries -/

section FixedPoint

variable {N : GradedLocalNet K} {G : Type*} [Monoid G]

/-- The fixed points, in the local algebra of `O`, of a monoid `G` acting by internal automorphisms
through `α : G →* N.Automorphism.internal`. -/
noncomputable def fixedPart (α : G →* Automorphism.internal N) (O : K) :
    StarSubalgebra ℂ (N.algebra O) :=
  StarAlgEquiv.fixedPoints ((Automorphism.internalAct N O).comp α)

/-- An element is fixed iff every internal automorphism `α g` fixes it. -/
lemma mem_fixedPart {α : G →* Automorphism.internal N} {O : K} {x : N.algebra O} :
    x ∈ fixedPart α O ↔ ∀ g, Automorphism.internalAct N O (α g) x = x :=
  StarAlgEquiv.mem_fixedPoints

/-- The fixed points are closed, so they form a C⋆-algebra. -/
instance instIsClosedFixedPart (α : G →* Automorphism.internal N) (O : K) :
    IsClosed (fixedPart α O : Set (N.algebra O)) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- The isotony embeddings carry fixed points to fixed points. -/
lemma incl_mem_fixedPart (α : G →* Automorphism.internal N) {O O' : K} (h : O ≤ O')
    (x : N.algebra O) (hx : x ∈ fixedPart α O) : N.incl h x ∈ fixedPart α O' :=
  mem_fixedPart.mpr fun g => by rw [Automorphism.internalAct_incl, mem_fixedPart.mp hx g]

/-- **The parity preserves the fixed points**, since automorphisms commute with the parity. -/
lemma parity_mem_fixedPart (α : G →* Automorphism.internal N) (O : K) (x : N.algebra O)
    (hx : x ∈ fixedPart α O) : N.parity O x ∈ fixedPart α O :=
  mem_fixedPart.mpr fun g => by rw [Automorphism.internalAct_parity, mem_fixedPart.mp hx g]

variable (N) in
/-- **The fixed-point subnet of a group of internal symmetries**: the fixed points of the local
algebras form a graded-local net (`GradedLocalNet.restrict`), the automorphisms commuting with the
parity. It is local when the fixed points are even, in particular when `N` is local
(`GradedLocalNet.instIsTriviallyGradedFixedPointNet`). The acting monoid is arbitrary: neither a
group nor compactness is assumed. -/
noncomputable def fixedPointNet (α : G →* Automorphism.internal N) : GradedLocalNet K :=
  N.restrict (fixedPart α) (fun _ _ h x hx => incl_mem_fixedPart α h x hx)
    (parity_mem_fixedPart α)

/-- The local algebras of the fixed-point subnet are the fixed points. -/
lemma fixedPointNet_algebra (α : G →* Automorphism.internal N) (O : K) :
    (N.fixedPointNet α).algebra O = fixedPart α O :=
  rfl

/-- The fixed-point subnet of a faithful net is faithful. -/
instance instFaithfulFixedPointNet [N.Faithful] (α : G →* Automorphism.internal N) :
    (N.fixedPointNet α).Faithful :=
  N.instFaithfulRestrict

/-- **The fixed-point subnet of a local net is local**: its parity is trivial. -/
instance instIsTriviallyGradedFixedPointNet [N.IsTriviallyGraded]
    (α : G →* Automorphism.internal N) : (N.fixedPointNet α).IsTriviallyGraded :=
  N.isTriviallyGraded_restrict fun _ x _ => N.parity_apply x

end FixedPoint

/-! ### The even subnet -/

section Even

variable (N : GradedLocalNet K)

/-- The parity of a local algebra is an involution. -/
lemma parity_mul_self (O : K) : N.parity O * N.parity O = 1 :=
  StarAlgEquiv.ext fun x => N.parity_parity x

/-- The **even part** of a local algebra: the C⋆-subalgebra of the elements fixed by the parity,
    the fixed-point algebra (`StarAlgEquiv.fixedPoints`) of the action of the grading group `ℤ₂`
    the parity generates (`StarAlgEquiv.involutionHom`). -/
noncomputable def evenPart (O : K) : StarSubalgebra ℂ (N.algebra O) :=
  StarAlgEquiv.fixedPoints (StarAlgEquiv.involutionHom (N.parity O) (N.parity_mul_self O))

/-- An element is even iff the parity fixes it. -/
@[simp] lemma mem_evenPart {O : K} {x : N.algebra O} : x ∈ N.evenPart O ↔ N.parity O x = x :=
  StarAlgEquiv.mem_fixedPoints_involutionHom

/-- The even part is closed, so it is a C⋆-algebra. -/
instance instIsClosedEvenPart (O : K) : IsClosed (N.evenPart O : Set (N.algebra O)) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- The parity automorphism as an internal automorphism. -/
noncomputable def parityInternal : Automorphism.internal N :=
  ⟨N.parityAutomorphism, N.parityAutomorphism_mem_internal⟩

/-- The parity, as a group of internal symmetries: the action of the grading group `ℤ₂` it
    generates. -/
noncomputable def paritySymmetry : Multiplicative (ZMod 2) →* Automorphism.internal N :=
  AddMonoidHom.toMultiplicativeLeft
    (ZMod.lift 2 ⟨zmultiplesHom (Additive (Automorphism.internal N)) (Additive.ofMul N.parityInternal),
      by
        change Additive.ofMul (N.parityInternal ^ (2 : ℤ)) = 0
        rw [zpow_two, show N.parityInternal * N.parityInternal = 1 from
          Subtype.ext N.parityAutomorphism_mul_self]
        rfl⟩)

/-- The generator of `ℤ₂` acts by the parity automorphism. -/
lemma paritySymmetry_ofAdd_one : N.paritySymmetry (Multiplicative.ofAdd 1) = N.parityInternal := by
  change Additive.toMul (ZMod.lift 2 _ ((1 : ℤ) : ZMod 2)) = _
  rw [ZMod.lift_coe]
  simp

/-- **The even part is the fixed-point algebra of the parity symmetry.** -/
lemma fixedPart_paritySymmetry (O : K) : fixedPart N.paritySymmetry O = N.evenPart O := by
  ext x
  rw [mem_fixedPart, mem_evenPart]
  refine ⟨fun h => ?_, fun h g => ?_⟩
  · have h₁ := h (Multiplicative.ofAdd 1)
    rw [paritySymmetry_ofAdd_one] at h₁
    exact (N.internalAct_parityAutomorphism O x).symm.trans h₁
  obtain ⟨a, rfl⟩ : ∃ a : ZMod 2, Multiplicative.ofAdd a = g := ⟨g.toAdd, rfl⟩
  rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) a with rfl | rfl
  · rw [ofAdd_zero, map_one, map_one]
    rfl
  · rw [paritySymmetry_ofAdd_one]
    exact (N.internalAct_parityAutomorphism O x).trans h

/-- The **even subnet** (Bose subnet) of a graded-local net: the even parts of the local algebras,
    with the restricted isotony embeddings (`GradedLocalNet.restrict`); its algebras are the
    fixed points of the parity symmetry (`GradedLocalNet.fixedPart_paritySymmetry`). It is a local
    net (`instIsTriviallyGradedEven`): for even elements graded locality is commutation. -/
noncomputable def even : GradedLocalNet K :=
  N.restrict N.evenPart
    (fun _ _ h x hx => N.mem_evenPart.mpr (by rw [N.parity_incl, N.mem_evenPart.mp hx]))
    fun _ _ hx => (N.mem_evenPart.mp hx).symm ▸ hx

/-- The even subnet is local. -/
instance instIsTriviallyGradedEven : N.even.IsTriviallyGraded :=
  N.isTriviallyGraded_restrict fun _ _ hx => N.mem_evenPart.mp hx

/-- The local algebras of the even subnet are the even parts. -/
lemma even_algebra (O : K) : N.even.algebra O = N.evenPart O :=
  rfl

/-- The isotony embeddings of the even subnet act as those of `N`. -/
@[simp] lemma coe_even_incl {O O' : K} (h : O ≤ O') (x : N.evenPart O) :
    (show N.evenPart O' from N.even.incl h x).val = N.incl h (x : N.algebra O) :=
  rfl

/-- The even subnet of a faithful net is faithful: its isotony embeddings are restrictions of
injective ones. -/
instance instFaithfulEven [N.Faithful] : N.even.Faithful :=
  N.instFaithfulRestrict

end Even

/-! ### The even part of the quasi-local algebra -/

section QuasiLocalEven

variable [IsDirectedOrder K] [Nonempty K] (N : GradedLocalNet K) [N.Faithful]

/-- The quasi-local parity is an involution, `Θ * Θ = 1`, so it generates an action of `ℤ₂`. -/
lemma quasiLocalParity_mul_self : N.quasiLocalParity * N.quasiLocalParity = 1 :=
  StarAlgEquiv.ext N.quasiLocalParity_quasiLocalParity

/-- The **even part of the quasi-local algebra** (the Bose algebra): the fixed-point algebra
(`StarAlgEquiv.fixedPoints`) of the action of `ℤ₂` generated by the quasi-local parity
(`StarAlgEquiv.involutionHom`). It is generated by the even subnet
(`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`). -/
noncomputable def quasiLocalEvenPart : StarSubalgebra ℂ N.quasiLocalCStarAlgebra :=
  StarAlgEquiv.fixedPoints (StarAlgEquiv.involutionHom N.quasiLocalParity N.quasiLocalParity_mul_self)

/-- An element of the quasi-local algebra is even iff the quasi-local parity fixes it. -/
@[simp] lemma mem_quasiLocalEvenPart {z : N.quasiLocalCStarAlgebra} :
    z ∈ N.quasiLocalEvenPart ↔ N.quasiLocalParity z = z :=
  StarAlgEquiv.mem_fixedPoints_involutionHom

/-- The even part of the quasi-local algebra is closed, so it is a C⋆-algebra. -/
instance instIsClosedQuasiLocalEvenPart : IsClosed (N.quasiLocalEvenPart : Set N.quasiLocalCStarAlgebra) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- A local observable is even in the quasi-local algebra iff it is even in its local algebra. -/
lemma ιLocalCStar_mem_quasiLocalEvenPart_iff {O : K} {x : N.algebra O} :
    N.ιLocalCStar O x ∈ N.quasiLocalEvenPart ↔ x ∈ N.evenPart O := by
  rw [mem_quasiLocalEvenPart, quasiLocalParity_ιLocalCStar, mem_evenPart]
  exact (N.ιLocalCStar_injective O).eq_iff

/-- **The even part of the quasi-local algebra is generated by the even subnet**: it is the closure
of the union of the even local algebras, embedded by the local embeddings of `N`. An even element
`z` is the limit of the averages `(y + Θ y) / 2` over `ℤ₂` (`StarAlgEquiv.average`) of local
observables `y → z`, and these averages are even local observables. -/
theorem closure_iUnion_range_even_eq_quasiLocalEvenPart :
    closure (⋃ O : K, Set.range fun x : N.even.algebra O =>
      N.ιLocalCStar O ((N.evenPart O).subtype x)) = N.quasiLocalEvenPart := by
  refine (closure_minimal ?_ (instIsClosedQuasiLocalEvenPart N)).antisymm fun z hz => ?_
  · rintro _ ⟨-, ⟨O, rfl⟩, x, rfl⟩
    exact N.ιLocalCStar_mem_quasiLocalEvenPart_iff.mpr x.2
  · let _ : Invertible (Fintype.card (Multiplicative (ZMod 2)) : ℂ) := invertibleOfNonzero (by simp)
    let α := StarAlgEquiv.involutionHom N.quasiLocalParity N.quasiLocalParity_mul_self
    have hP : Continuous (StarAlgEquiv.average α) := by
      rw [show ⇑(StarAlgEquiv.average α) = _ from funext (StarAlgEquiv.average_apply α)]
      exact (continuous_finsetSum _ fun g _ => (StarAlgEquiv.isometry (α g)).continuous).const_smul
        (⅟(Fintype.card (Multiplicative (ZMod 2)) : ℂ))
    rw [← StarAlgEquiv.average_eq_self hz]
    refine closure_mono ?_ (image_closure_subset_closure_image hP
      ⟨z, N.dense_iUnion_range_ιLocalCStar.closure_eq ▸ Set.mem_univ z, rfl⟩)
    rintro _ ⟨-, ⟨-, ⟨O, rfl⟩, y, rfl⟩, rfl⟩
    refine Set.mem_iUnion.mpr ⟨O, ⟨_, StarAlgEquiv.average_mem_fixedPoints
      (StarAlgEquiv.involutionHom (N.parity O) (N.parity_mul_self O)) y⟩, ?_⟩
    change N.ιLocalCStar O
      (StarAlgEquiv.average (StarAlgEquiv.involutionHom (N.parity O) (N.parity_mul_self O)) y) = _
    rw [StarAlgEquiv.average_involutionHom, StarAlgEquiv.average_involutionHom, map_smul, map_add,
      quasiLocalParity_ιLocalCStar]

end QuasiLocalEven

end GradedLocalNet
