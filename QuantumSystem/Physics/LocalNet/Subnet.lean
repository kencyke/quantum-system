module

public import QuantumSystem.Analysis.CStarAlgebra.DynamicalSystem
public import QuantumSystem.Physics.LocalNet.Covariance.QuasiLocal

/-!
# Subnets of a net

The subnets of a graded-local net (`GradedLocalNet`, defined in
`QuantumSystem.Physics.LocalNet.Basic`): nets of C⋆-subalgebras of its local algebras, with the
restricted isotony embeddings.

* The **fixed-point subnet** `GradedLocalNet.InternalSymmetry.fixedPointNet` of an internal symmetry,
  an action of a monoid on every local algebra compatible with the isotony embeddings and leaving
  the regions in place: when its fixed points are even, they form a local net, since on even
  elements graded locality is commutation. It applies to a local net as well, whose elements are
  all even (`GradedLocalNet.InternalSymmetry.fixedPointNetOfIsLocal`).
* The **even subnet** (Bose subnet) `GradedLocalNet.even`: the even elements of every local algebra
  form a C⋆-subalgebra `GradedLocalNet.evenPart`, the fixed points of the parity, and these
  subalgebras form a local net, the fixed-point subnet of the action of `ℤ₂` generated by the
  parity (`GradedLocalNet.paritySymmetry`). It is faithful when the net is. For a faithful net over
  a directed index set, the even part of the quasi-local algebra `GradedLocalNet.quasiLocalEvenPart`
  — the fixed points of the action of `ℤ₂` generated by the quasi-local parity — is the closure of
  the even local algebras (`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`).

No graded-local net with a non-trivial parity is built in the development, so the even subnet is
inhabited only by local nets, where it is the whole net.

## Main definitions

* `GradedLocalNet.InternalSymmetry N G` — an action of `G` on the local algebras, compatible with
  the isotony embeddings; `GradedLocalNet.InternalSymmetry.fixedPointNet` — its fixed-point subnet.
* `GradedLocalNet.InternalSymmetry.toCovarianceHom` — an internal symmetry commuting with the parity,
  as a homomorphism into the covariances that leave every region in place.
* `GradedLocalNet.paritySymmetry N` — the action of `ℤ₂` generated by the parity.
* `GradedLocalNet.evenPart N O` — the C⋆-subalgebra of the even elements of `𝔄(O)`.
* `GradedLocalNet.even N` — the even subnet, a local net.
* `GradedLocalNet.quasiLocalEvenPart N` — the C⋆-subalgebra of the even elements of the quasi-local
  algebra.

## Main results

* `GradedLocalNet.mem_evenPart` — an element is in the even part iff the parity fixes it.
* `GradedLocalNet.instFaithfulEven` — the even subnet of a faithful net is faithful.
* `GradedLocalNet.ιLocalCStar_mem_quasiLocalEvenPart_iff` — a local observable is even in the
  quasi-local algebra iff it is even locally.
* **`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`** — the even part of the
  quasi-local algebra is generated by the even subnet.
-/

@[expose] public section

open scoped CausalOrthogonality

namespace GradedLocalNet

variable {K : Type*} [Preorder K] [CausalOrthogonality K]

/-! ### The fixed-point subnet of an internal symmetry -/

section FixedPoint

variable (N : GradedLocalNet K) {G : Type*} [Monoid G]

/-- An **internal symmetry** of a graded-local net: an action `α O` of a monoid `G` on every local
algebra by ⋆-automorphisms, compatible with the isotony embeddings and leaving every region in
place. -/
structure InternalSymmetry (G : Type*) [Monoid G] where
  /-- The action on the local algebra of `O`. -/
  act (O : K) : G →* (N.algebra O ≃⋆ₐ[ℂ] N.algebra O)
  /-- The action is compatible with the isotony embeddings. -/
  act_incl {O O' : K} (h : O ≤ O') (g : G) (x : N.algebra O) :
    act O' g (N.incl h x) = N.incl h (act O g x)

variable {N}

/-- The fixed points of an internal symmetry in the local algebra of `O`. -/
noncomputable def InternalSymmetry.fixedPart (α : N.InternalSymmetry G) (O : K) :
    StarSubalgebra ℂ (N.algebra O) :=
  StarAlgEquiv.fixedPoints (α.act O)

/-- The fixed points are closed, so they form a C⋆-algebra. -/
instance InternalSymmetry.instIsClosedFixedPart (α : N.InternalSymmetry G) (O : K) :
    IsClosed (α.fixedPart O : Set (N.algebra O)) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- The isotony embedding restricted to the fixed points. -/
noncomputable def InternalSymmetry.fixedIncl (α : N.InternalSymmetry G) {O O' : K} (h : O ≤ O') :
    α.fixedPart O →⋆ₐ[ℂ] α.fixedPart O' :=
  ((N.incl h).comp (α.fixedPart O).subtype).codRestrict (α.fixedPart O') fun x =>
    StarAlgEquiv.mem_fixedPoints.mpr fun g => by
      change α.act O' g (N.incl h x) = N.incl h x
      rw [α.act_incl, StarAlgEquiv.mem_fixedPoints.mp x.2 g]

/-- **The fixed-point subnet of an internal symmetry whose fixed points are even**: the fixed points
of the local algebras form a local net, since even elements of causally orthogonal regions commute.
The even subnet is the case of the action of `ℤ₂` generated by the parity (`GradedLocalNet.even`);
for a local net, whose parity is trivial, every internal symmetry qualifies
(`GradedLocalNet.InternalSymmetry.fixedPointNetOfIsLocal`). -/
noncomputable def InternalSymmetry.fixedPointNet (α : N.InternalSymmetry G)
    (heven : ∀ O, ∀ x ∈ α.fixedPart O, N.parity O x = x) : GradedLocalNet K :=
  ofLocality
    { algebra := fun O => α.fixedPart O
      incl := fun h => α.fixedIncl h
      incl_refl := fun x => Subtype.ext (N.incl_refl x.1)
      incl_trans := fun h₁₂ h₂₃ x => Subtype.ext (N.incl_trans h₁₂ h₂₃ x.1) }
    fun _ _ _ h₁ h₂ hd x y =>
      Subtype.ext (N.locality_even h₁ h₂ hd x.1 y.1 (heven _ x.1 x.2)).eq

/-- The fixed-point subnet is local. -/
instance InternalSymmetry.instIsLocalFixedPointNet (α : N.InternalSymmetry G)
    (heven : ∀ O, ∀ x ∈ α.fixedPart O, N.parity O x = x) : (α.fixedPointNet heven).IsLocal :=
  instIsLocalOfLocality _ _

/-- The local algebras of the fixed-point subnet are the fixed points. -/
lemma InternalSymmetry.fixedPointNet_algebra (α : N.InternalSymmetry G)
    (heven : ∀ O, ∀ x ∈ α.fixedPart O, N.parity O x = x) (O : K) :
    (α.fixedPointNet heven).algebra O = α.fixedPart O :=
  rfl

/-- The fixed-point subnet of a faithful net is faithful. -/
instance InternalSymmetry.instFaithfulFixedPointNet [N.Faithful] (α : N.InternalSymmetry G)
    (heven : ∀ O, ∀ x ∈ α.fixedPart O, N.parity O x = x) : (α.fixedPointNet heven).Faithful where
  incl_injective h _ _ hxy :=
    Subtype.ext (CStarNet.Faithful.incl_injective (N := N.toCStarNet) h (congrArg Subtype.val hxy))

/-- **The fixed-point subnet of an internal symmetry of a local net**: the parity of a local net is
trivial, so the fixed points of every internal symmetry are even. -/
noncomputable def InternalSymmetry.fixedPointNetOfIsLocal [N.IsLocal]
    (α : N.InternalSymmetry G) : GradedLocalNet K :=
  α.fixedPointNet fun _ x _ => N.parity_apply x

/-- An internal symmetry commuting with the parity, as a covariance leaving every region in place. -/
noncomputable def InternalSymmetry.toCovariance (α : N.InternalSymmetry G)
    (hpar : ∀ O g (x : N.algebra O), α.act O g (N.parity O x) = N.parity O (α.act O g x)) (g : G) :
    N.Covariance where
  σ := OrderIso.refl K
  map_orthogonal_iff := by intro _ _; exact Iff.rfl
  β O := α.act O g
  β_incl h x := α.act_incl h g x
  β_parity O x := hpar O g x

/-- **An internal symmetry commuting with the parity is a homomorphism into the covariances** whose
region maps are the identity. -/
noncomputable def InternalSymmetry.toCovarianceHom (α : N.InternalSymmetry G)
    (hpar : ∀ O g (x : N.algebra O), α.act O g (N.parity O x) = N.parity O (α.act O g x)) :
    G →* N.Covariance where
  toFun := α.toCovariance hpar
  map_one' := Covariance.ext rfl fun O x h => by
    refine (N.algebraCongr_self h _).trans ?_
    simp [toCovariance]
    rfl
  map_mul' g g' := Covariance.ext rfl fun O x h => by
    refine (N.algebraCongr_self h _).trans ?_
    simp [toCovariance]
    rfl

end FixedPoint

/-! ### The even subnet -/

section Even

variable (N : GradedLocalNet K)

/-- The parity of a local algebra is an involution. -/
lemma parity_mul_self (O : K) : N.parity O * N.parity O = 1 :=
  StarAlgEquiv.ext fun x => N.parity_parity x

/-- The **even part** of a local algebra: the C⋆-subalgebra of the elements fixed by the parity,
    the fixed-point algebra (`StarAlgEquiv.fixedPoints`) of the action of the grading group `ℤ₂`
    the parity generates (`StarAlgEquiv.involutionHom`). -/
noncomputable def evenPart (O : K) : StarSubalgebra ℂ (N.algebra O) :=
  StarAlgEquiv.fixedPoints (StarAlgEquiv.involutionHom (N.parity O) (N.parity_mul_self O))

/-- An element is even iff the parity fixes it. -/
@[simp] lemma mem_evenPart {O : K} {x : N.algebra O} : x ∈ N.evenPart O ↔ N.parity O x = x :=
  StarAlgEquiv.mem_fixedPoints_involutionHom

/-- The even part is closed, so it is a C⋆-algebra. -/
instance instIsClosedEvenPart (O : K) : IsClosed (N.evenPart O : Set (N.algebra O)) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- The parity, as an internal symmetry: the action of the grading group `ℤ₂` it generates. -/
noncomputable def paritySymmetry : N.InternalSymmetry (Multiplicative (ZMod 2)) where
  act O := StarAlgEquiv.involutionHom (N.parity O) (N.parity_mul_self O)
  act_incl h g x := by
    obtain ⟨a, rfl⟩ : ∃ a : ZMod 2, Multiplicative.ofAdd a = g := ⟨g.toAdd, rfl⟩
    rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) a with rfl | rfl
    · rw [ofAdd_zero, map_one, map_one]
      rfl
    · rw [StarAlgEquiv.involutionHom_ofAdd_one, StarAlgEquiv.involutionHom_ofAdd_one]
      exact N.parity_incl h x

/-- The isotony embedding of the even parts: the restriction of `incl`, which preserves the
    parity. -/
noncomputable def evenIncl {O O' : K} (h : O ≤ O') : N.evenPart O →⋆ₐ[ℂ] N.evenPart O' :=
  N.paritySymmetry.fixedIncl h

/-- The restricted isotony embedding acts as `incl`. -/
@[simp] lemma coe_evenIncl {O O' : K} (h : O ≤ O') (x : N.evenPart O) :
    (N.evenIncl h x : N.algebra O') = N.incl h (x : N.algebra O) :=
  rfl

/-- The **even subnet** (Bose subnet) of a graded-local net: the even parts of the local algebras,
    with the restricted isotony embeddings, the fixed-point subnet of the parity. It is a local
    net (`instIsLocalEven`): for even elements graded locality is commutation. -/
noncomputable def even : GradedLocalNet K :=
  N.paritySymmetry.fixedPointNet fun _ _ hx => N.mem_evenPart.mp hx

/-- The even subnet is local. -/
instance instIsLocalEven : N.even.IsLocal :=
  InternalSymmetry.instIsLocalFixedPointNet _ _

/-- The local algebras of the even subnet are the even parts. -/
lemma even_algebra (O : K) : N.even.algebra O = N.evenPart O :=
  rfl

/-- The isotony embeddings of the even subnet are the restricted ones. -/
lemma even_incl {O O' : K} (h : O ≤ O') : N.even.incl h = N.evenIncl h :=
  rfl

/-- The even subnet of a faithful net is faithful: its isotony embeddings are restrictions of
injective ones. -/
instance instFaithfulEven [N.Faithful] : N.even.Faithful where
  incl_injective h _ _ hxy :=
    Subtype.ext (CStarNet.Faithful.incl_injective (N := N.toCStarNet) h (congrArg Subtype.val hxy))

end Even

/-! ### The even part of the quasi-local algebra -/

section QuasiLocalEven

variable [IsDirectedOrder K] [Nonempty K] (N : GradedLocalNet K) [N.Faithful]

/-- The quasi-local parity generates an action of `ℤ₂`. -/
lemma quasiLocalParity_mul_self : N.quasiLocalParity * N.quasiLocalParity = 1 :=
  StarAlgEquiv.ext N.quasiLocalParity_quasiLocalParity

/-- The **even part of the quasi-local algebra** (the Bose algebra): the fixed-point algebra
(`StarAlgEquiv.fixedPoints`) of the action of `ℤ₂` generated by the quasi-local parity
(`StarAlgEquiv.involutionHom`). It is generated by the even subnet
(`GradedLocalNet.closure_iUnion_range_even_eq_quasiLocalEvenPart`). -/
noncomputable def quasiLocalEvenPart : StarSubalgebra ℂ N.quasiLocalCStarAlgebra :=
  StarAlgEquiv.fixedPoints (StarAlgEquiv.involutionHom N.quasiLocalParity N.quasiLocalParity_mul_self)

/-- An element of the quasi-local algebra is even iff the quasi-local parity fixes it. -/
@[simp] lemma mem_quasiLocalEvenPart {z : N.quasiLocalCStarAlgebra} :
    z ∈ N.quasiLocalEvenPart ↔ N.quasiLocalParity z = z :=
  StarAlgEquiv.mem_fixedPoints_involutionHom

/-- The even part of the quasi-local algebra is closed, so it is a C⋆-algebra. -/
instance instIsClosedQuasiLocalEvenPart : IsClosed (N.quasiLocalEvenPart : Set N.quasiLocalCStarAlgebra) :=
  StarAlgEquiv.instIsClosedFixedPoints _

/-- A local observable is even in the quasi-local algebra iff it is even in its local algebra. -/
lemma ιLocalCStar_mem_quasiLocalEvenPart_iff {O : K} {x : N.algebra O} :
    N.ιLocalCStar O x ∈ N.quasiLocalEvenPart ↔ x ∈ N.evenPart O := by
  rw [mem_quasiLocalEvenPart, quasiLocalParity_ιLocalCStar, mem_evenPart]
  exact (N.ιLocalCStar_injective O).eq_iff

/-- **The even part of the quasi-local algebra is generated by the even subnet**: it is the closure
of the union of the even local algebras, embedded by the local embeddings of `N`. An even element
`z` is the limit of the averages `(y + Θ y) / 2` over `ℤ₂` (`StarAlgEquiv.average`) of local
observables `y → z`, and these averages are even local observables. -/
theorem closure_iUnion_range_even_eq_quasiLocalEvenPart :
    closure (⋃ O : K, Set.range fun x : N.even.algebra O =>
      N.ιLocalCStar O ((N.evenPart O).subtype x)) = N.quasiLocalEvenPart := by
  refine (closure_minimal ?_ (instIsClosedQuasiLocalEvenPart N)).antisymm fun z hz => ?_
  · rintro _ ⟨-, ⟨O, rfl⟩, x, rfl⟩
    exact N.ιLocalCStar_mem_quasiLocalEvenPart_iff.mpr x.2
  · let _ : Invertible (Fintype.card (Multiplicative (ZMod 2)) : ℂ) := invertibleOfNonzero (by simp)
    let α := StarAlgEquiv.involutionHom N.quasiLocalParity N.quasiLocalParity_mul_self
    have hP : Continuous (StarAlgEquiv.average α) := by
      rw [show ⇑(StarAlgEquiv.average α) = _ from funext (StarAlgEquiv.average_apply α)]
      exact (continuous_finsetSum _ fun g _ => (StarAlgEquiv.isometry (α g)).continuous).const_smul
        (⅟(Fintype.card (Multiplicative (ZMod 2)) : ℂ))
    rw [← StarAlgEquiv.average_eq_self hz]
    refine closure_mono ?_ (image_closure_subset_closure_image hP
      ⟨z, N.denseRange_iUnion_ιLocalCStar.closure_eq ▸ Set.mem_univ z, rfl⟩)
    rintro _ ⟨-, ⟨-, ⟨O, rfl⟩, y, rfl⟩, rfl⟩
    refine Set.mem_iUnion.mpr ⟨O, ⟨_, StarAlgEquiv.average_mem_fixedPoints
      (N.paritySymmetry.act O) y⟩, ?_⟩
    change N.ιLocalCStar O
      (StarAlgEquiv.average (StarAlgEquiv.involutionHom (N.parity O) (N.parity_mul_self O)) y) = _
    rw [StarAlgEquiv.average_involutionHom, StarAlgEquiv.average_involutionHom, map_smul, map_add,
      quasiLocalParity_ιLocalCStar]

end QuasiLocalEven

end GradedLocalNet
