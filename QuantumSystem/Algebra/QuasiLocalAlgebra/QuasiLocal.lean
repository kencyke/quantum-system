module

public import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
public import QuantumSystem.Algebra.QuasiLocalAlgebra.LocalEmbed

/-!
# Quasi-local algebra

The quasi-local algebra of an infinite lattice system is the norm closure of
the `*`-algebra generated by all finite-region local subalgebras
(Naaijkens 2012 §1.3 / Bratteli–Robinson Vol. 2 §2.7.2):

`𝔄_alg := ⨆ Λ : Finset L, 𝔄(Λ)`,  `quasiLocal L Ω := closure 𝔄_alg`.

The supremum is taken in the complete lattice of
`StarSubalgebra ℂ (globalHilbert L Ω →L[ℂ] globalHilbert L Ω)`.

## Main definitions

* `LocalNetLike.quasiLocalSubalg L Ω` — algebraic core
  `⨆ Λ : Finset L, localSubalgebra Λ`.
* `LocalNetLike.quasiLocal L Ω` — its norm closure.
* `LocalNetLike.concreteQuasiLocal L Ω` — semantic alias.

## References

* Naaijkens, *Anyons in Infinite Quantum Systems*, 2012, §1.3.
* Bratteli, Robinson, *Operator Algebras and Quantum Statistical Mechanics II*,
  §2.7.2.
-/

@[expose] public section

namespace LocalNetLike

variable (L : Type*) [DecidableEq L] [LocalNetLike L]
variable (Ω : (s : L) → LocalNetLike.localIdx (L := L) s)

/-- Algebraic core `⨆ Λ : Finset L, localSubalgebra Λ`: the `*`-subalgebra of
`globalHilbert L Ω →L[ℂ] globalHilbert L Ω` generated by all local operators. -/
noncomputable def quasiLocalSubalg :
    StarSubalgebra ℂ (globalHilbert L Ω →L[ℂ] globalHilbert L Ω) :=
  ⨆ Λ : Finset L, localSubalgebra (Ω := Ω) Λ

/-- The **quasi-local algebra** of the lattice system: the norm closure of
the algebraic local core generated by all local subalgebras. -/
noncomputable def quasiLocal :
    StarSubalgebra ℂ (globalHilbert L Ω →L[ℂ] globalHilbert L Ω) :=
  (quasiLocalSubalg L Ω).topologicalClosure

/-- Semantic alias for `quasiLocal L Ω` as the concrete represented observable
algebra on `concreteLatticeRepresentation L Ω`. -/
noncomputable abbrev concreteQuasiLocal :
    StarSubalgebra ℂ
      (globalHilbert L Ω →L[ℂ] globalHilbert L Ω) :=
  quasiLocal L Ω

/-- Each local subalgebra is contained in the algebraic quasi-local core. -/
theorem localSubalgebra_le_quasiLocalSubalg (Λ : Finset L) :
    localSubalgebra (Ω := Ω) Λ ≤ quasiLocalSubalg L Ω :=
  le_iSup (fun Λ : Finset L => localSubalgebra (Ω := Ω) Λ) Λ

/-- Each local subalgebra is contained in the quasi-local algebra. -/
theorem localSubalgebra_le_quasiLocal (Λ : Finset L) :
    localSubalgebra (Ω := Ω) Λ ≤ quasiLocal L Ω :=
  (localSubalgebra_le_quasiLocalSubalg L Ω Λ).trans
    (StarSubalgebra.le_topologicalClosure _)

/-- The algebraic quasi-local core is contained in the quasi-local
algebra. -/
theorem quasiLocalSubalg_le_quasiLocal :
    quasiLocalSubalg L Ω ≤ quasiLocal L Ω :=
  StarSubalgebra.le_topologicalClosure _

/-- The quasi-local algebra is closed in the operator-norm topology. -/
theorem isClosed_quasiLocal :
    IsClosed
      (↑(quasiLocal L Ω) : Set (globalHilbert L Ω →L[ℂ] globalHilbert L Ω)) :=
  StarSubalgebra.isClosed_topologicalClosure _

/-- The quasi-local algebra `quasiLocal L Ω` is a closed subset of
`B(globalHilbert L Ω)`. -/
instance instIsClosed_quasiLocal :
    IsClosed (SetLike.coe (quasiLocal L Ω)) :=
  isClosed_quasiLocal L Ω

/-- The **quasi-local algebra is a unital C⋆-algebra**, via the closed-subalgebra
`CStarAlgebra` instance and `isClosed_quasiLocal`. -/
noncomputable instance instCStarAlgebra_quasiLocal :
    CStarAlgebra ↥(quasiLocal L Ω) :=
  inferInstance

end LocalNetLike
