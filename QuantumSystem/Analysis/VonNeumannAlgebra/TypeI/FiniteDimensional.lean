module

public import QuantumSystem.Analysis.CStarAlgebra.FiniteDimensional
public import QuantumSystem.Analysis.VonNeumannAlgebra.DoubleCommutant.TFAE
public import QuantumSystem.Analysis.VonNeumannAlgebra.TypeI.Defs

/-!
# Finite-dimensional factors in `B(H)` are type I factors

A finite-dimensional `⋆`-subalgebra of `B(H)` is WOT-closed, being a finite-dimensional subspace of
a Hausdorff topological vector space, so the von Neumann algebra it generates is itself. When it is
the image of a finite-dimensional factor `A` under a unital `⋆`-homomorphism, the homomorphism is
injective (`A` is simple, `CStarAlgebra.isSimpleRing_of_isCentral_of_finiteDimensional`), and the
image is `⋆`-isomorphic to `A`, hence to a full matrix algebra, hence to `B(ℂⁿ)`: a type I factor.

## Main results

* `VonNeumannAlgebra.isWOTClosed_of_finiteDimensional` — a finite-dimensional `⋆`-subalgebra of
  `B(H)` is WOT-closed.
* `VonNeumannAlgebra.isTypeIFactor_generated_range` — the von Neumann algebra generated by the image
  of a finite-dimensional factor under a unital `⋆`-homomorphism is a type I factor.
-/

@[expose] public section

open WeakOperatorTopology

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- **A finite-dimensional `⋆`-subalgebra of `B(H)` is WOT-closed**: its image in the WOT type copy
is a finite-dimensional subspace of a Hausdorff topological vector space. -/
lemma isWOTClosed_of_finiteDimensional (S : StarSubalgebra ℂ (H →L[ℂ] H))
    [FiniteDimensional ℂ S] : IsWOTClosed (H := H) (S : Set (H →L[ℂ] H)) := by
  let M : Submodule ℂ (H →L[ℂ] H) := Subalgebra.toSubmodule S.toSubalgebra
  have : FiniteDimensional ℂ M := ‹FiniteDimensional ℂ S›
  let f : (H →L[ℂ] H) →ₗ[ℂ] (H →WOT[ℂ] H) :=
    (ContinuousLinearMap.WOTofCLM : (H →L[ℂ] H) →L[ℂ] (H →WOT[ℂ] H)).toLinearMap
  have h := (M.map f).closed_of_finiteDimensional
  rw [Submodule.map_coe] at h
  exact h

/-- **The image of a finite-dimensional factor generates a type I factor**: for a unital
`⋆`-homomorphism `φ : A → B(H)` from a finite-dimensional factor, `φ(A)″` is a type I factor. The
image is WOT-closed (`isWOTClosed_of_finiteDimensional`), so it is the generated von Neumann
algebra; `φ` is injective, `A` being simple; and `A` is a full matrix algebra
(`CStarAlgebra.exists_starAlgEquiv_cstarMatrix_of_isCentral`), so `φ(A)″ ≃⋆ₐ B(ℂⁿ)`. -/
theorem isTypeIFactor_generated_range {A : Type*} [CStarAlgebra A] [FiniteDimensional ℂ A]
    [Nontrivial A] [Algebra.IsCentral ℂ A] (φ : A →⋆ₐ[ℂ] (H →L[ℂ] H)) :
    IsTypeIFactor (generated (Set.range φ)) := by
  rcases subsingleton_or_nontrivial H with _ | _
  · exact isTypeIFactor_of_subsingleton _
  have := CStarAlgebra.isSimpleRing_of_isCentral_of_finiteDimensional A
  have hφ : Function.Injective φ := RingHom.injective (φ : A →+* (H →L[ℂ] H))
  have : FiniteDimensional ℂ φ.range :=
    Module.Finite.of_surjective (φ.rangeRestrict : A →ₗ[ℂ] φ.range) fun y => by
      obtain ⟨a, ha⟩ := y.2
      exact ⟨a, Subtype.ext ha⟩
  have hS : (generated (Set.range φ) : Set (H →L[ℂ] H)) = Set.range φ :=
    generated_coe_of_isWOTClosed φ.range (isWOTClosed_of_finiteDimensional _)
  have hmem (x : H →L[ℂ] H) : x ∈ generated (Set.range φ) ↔ x ∈ φ.range := by
    rw [← SetLike.mem_coe, hS]
    rfl
  let ψ : generated (Set.range φ) ≃⋆ₐ[ℂ] φ.range :=
    { toFun x := ⟨x, (hmem x).mp x.2⟩
      invFun y := ⟨y, (hmem y).mpr y.2⟩
      left_inv _ := rfl
      right_inv _ := rfl
      map_mul' _ _ := rfl
      map_add' _ _ := rfl
      map_star' _ := rfl
      map_smul' _ _ := rfl }
  obtain ⟨n, _, ⟨e⟩⟩ := CStarAlgebra.exists_starAlgEquiv_cstarMatrix_of_isCentral A
  exact isTypeIFactor_of_starAlgEquiv_continuousLinearMap
    (ψ.trans ((StarAlgEquiv.ofInjective φ hφ).symm.trans
      ((e.trans CStarMatrix.ofMatrixStarAlgEquiv.symm).trans Matrix.toEuclideanCLM)))

end VonNeumannAlgebra
