represents a `WStarAlgebra` as a von Neumann algebra on a Hilbert space.
-/

@[expose] public section

namespace VonNeumannAlgebra

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Factors

A von Neumann algebra `N` is a **factor** when its centre `N.center = N ∩ N′` is trivial. The
centre of the ring `N` has the same elements, so this is Mathlib's `Algebra.IsCentral ℂ N`: the
centre of `N` is the image of `ℂ`. Factors are stated with that class throughout, as
`[Algebra.IsCentral ℂ N]`; the characterisation through the centre `N.center` is
`VonNeumannAlgebra.isCentral_iff`. -/

/-- **The commutant of `B(H)` is the scalars**: an operator commutes with every bounded operator
exactly when it is a scalar multiple of the identity. -/
lemma mem_commutant_boundedLinearOperators_iff {x : H →L[ℂ] H} :
    x ∈ (𝓑(H))′ ↔ ∃ c : ℂ, x = c • 1 := by
  refine ⟨fun hx => ?_, ?_⟩
  · obtain ⟨c, hc⟩ := (Algebra.IsCentral.mem_center_iff ℂ).mp (Subalgebra.mem_center_iff.mpr
      fun g => mem_commutant_iff.mp hx g (mem_boundedLinearOperators g))
    exact ⟨c, by rw [hc, Algebra.algebraMap_eq_smul_one]⟩
  · rintro ⟨c, rfl⟩
    exact SMulMemClass.smul_mem c (one_mem _)

/-- **`N` is a factor iff its centre is the scalars**: `Algebra.IsCentral ℂ N` holds iff the
centre `N.center = N ∩ N′` is the von Neumann algebra `(𝓑(H))′` of the scalar multiples of the
identity (`mem_commutant_boundedLinearOperators_iff`). -/
lemma isCentral_iff {N : VonNeumannAlgebra H} :
    Algebra.IsCentral ℂ N ↔ N.center = (𝓑(H))′ := by
  refine ⟨fun h => le_antisymm (fun x hx => ?_) (fun x hx => ?_), fun h => ⟨fun z hz => ?_⟩⟩
  · obtain ⟨hxN, hxc⟩ := mem_center_iff_exists_mem_subalgebraCenter.mp hx
    obtain ⟨c, hc⟩ := (Algebra.IsCentral.mem_center_iff ℂ).mp hxc
    exact mem_commutant_boundedLinearOperators_iff.mpr
      ⟨c, by simpa [Algebra.algebraMap_eq_smul_one] using congrArg Subtype.val hc⟩
  · obtain ⟨c, rfl⟩ := mem_commutant_boundedLinearOperators_iff.mp hx
    exact SMulMemClass.smul_mem c (one_mem _)
  · obtain ⟨c, hc⟩ := mem_commutant_boundedLinearOperators_iff.mp
      (h.le (mem_center_iff_exists_mem_subalgebraCenter.mpr ⟨z.2, hz⟩))
    exact ⟨c, Subtype.ext (by simp [Algebra.algebraMap_eq_smul_one, hc])⟩

/-- In a factor, an operator of the centre `N.center = N ∩ N′` is a scalar multiple of the
identity. -/
lemma exists_eq_smul_one_of_isCentral {N : VonNeumannAlgebra H} [h : Algebra.IsCentral ℂ N]
    {x : H →L[ℂ] H} (hx : x ∈ N.center) : ∃ c : ℂ, x = c • 1 :=
  mem_commutant_boundedLinearOperators_iff.mp ((isCentral_iff.mp h).le hx)

/-- On the zero Hilbert space, where `0` is the only operator, every von Neumann algebra is a
factor: its centre and the scalars are both the zero algebra. -/
lemma isCentral_of_subsingleton [Subsingleton (H →L[ℂ] H)] (N : VonNeumannAlgebra H) :
    Algebra.IsCentral ℂ N :=
  isCentral_iff.mpr (ext fun x => by
    rw [Subsingleton.elim x 0]
    exact iff_of_true (zero_mem _) (zero_mem _))

/-- **The commutant of a factor is a factor.** The centre of `N′` is the centre of `N`
(`center_commutant`), since `N′′ = N`. -/
instance isCentral_commutant {N : VonNeumannAlgebra H} [h : Algebra.IsCentral ℂ N] :
    Algebra.IsCentral ℂ N′ :=
  isCentral_iff.mpr (by rw [center_commutant]; exact isCentral_iff.mp h)

/-- A von Neumann algebra is a factor iff its commutant is. -/
lemma isCentral_commutant_iff {N : VonNeumannAlgebra H} :
    Algebra.IsCentral ℂ N′ ↔ Algebra.IsCentral ℂ N :=
  ⟨fun _ => commutant_commutant N ▸ isCentral_commutant (N := N′),
    fun _ => inferInstance⟩

/-- **`B(H)` is a factor.** `𝓑(H)` is `⋆`-isomorphic to `H →L[ℂ] H`, which is central by Mathlib's
`Algebra.IsCentral.instContinuousLinearMap`. -/
instance isCentral_boundedLinearOperators : Algebra.IsCentral ℂ 𝓑(H) :=
  .of_algEquiv' (boundedLinearOperators.starAlgEquiv (H := H)).symm.toAlgEquiv

/-! ### Central projections -/

/-- A **central projection** of `N`: a star projection of the centre `N.center = N ∩ N′`, that
is, one lying in both `N` and its commutant. -/
def IsCentralProjection (N : VonNeumannAlgebra H) (e : H →L[ℂ] H) : Prop :=
  IsStarProjection e ∧ e ∈ N.center

/-- A central projection is a star projection. -/
lemma IsCentralProjection.isStarProjection {N : VonNeumannAlgebra H} {e : H →L[ℂ] H}
    (he : IsCentralProjection N e) : IsStarProjection e :=
  he.1

/-- A central projection of `N` lies in `N`. -/
lemma IsCentralProjection.mem {N : VonNeumannAlgebra H} {e : H →L[ℂ] H}
    (he : IsCentralProjection N e) : e ∈ N :=
  center_le N he.2

/-- A central projection of `N` lies in the commutant of `N`. -/
lemma IsCentralProjection.mem_commutant {N : VonNeumannAlgebra H} {e : H →L[ℂ] H}
    (he : IsCentralProjection N e) : e ∈ N′ :=
  center_le_commutant N he.2

/-- `0` is a central projection. -/
lemma IsCentralProjection.zero (N : VonNeumannAlgebra H) : IsCentralProjection N 0 :=
  ⟨IsStarProjection.zero _, zero_mem _, zero_mem _⟩

/-- `1` is a central projection. -/
lemma IsCentralProjection.one (N : VonNeumannAlgebra H) : IsCentralProjection N 1 :=
  ⟨IsStarProjection.one _, one_mem _, one_mem _⟩

/-- In a factor, every central projection is trivial: it is `0` or `1`. This is the
projection-level form of the triviality of the centre: a nonzero central idempotent of a central
algebra is `1` (`Algebra.IsCentral.eq_one_of_isIdempotentElem`). On a subsingleton `H` the
conclusion holds trivially (every operator is `0 = 1`), which is why no nontriviality hypothesis is
needed. -/
lemma IsCentralProjection.eq_zero_or_eq_one {N : VonNeumannAlgebra H} [Algebra.IsCentral ℂ N]
    {e : H →L[ℂ] H} (he : IsCentralProjection N e) :
    e = 0 ∨ e = 1 := by
  by_cases he0 : e = 0
  · exact Or.inl he0
  have : Nontrivial H := ContinuousLinearMap.nontrivial_of_ne_zero he0
  have h1 : (⟨e, he.mem⟩ : N) = 1 :=
    Algebra.IsCentral.eq_one_of_isIdempotentElem (K := ℂ)
      (mem_center_iff_exists_mem_subalgebraCenter.mp he.2).2
      (Subtype.ext he.1.isIdempotentElem) fun h => he0 (congrArg Subtype.val h)
  exact Or.inr (congrArg Subtype.val h1)

/-- A star projection lies in the commutant `N′` exactly when its range is invariant under every
element of `N`. This is the bridge between reducing subspaces and (eventually central)
projections: it follows from the double-commutant characterisation
`VonNeumannAlgebra.IsStarProjection.mem_iff` together with `commutant_commutant`. -/
lemma IsStarProjection.mem_commutant_iff {N : VonNeumannAlgebra H} {e : H →L[ℂ] H}
    (he : IsStarProjection e) :
    e ∈ N′ ↔ ∀ y ∈ N, (e.range) ∈ Module.End.invtSubmodule (y : Module.End ℂ H) := by
  rw [IsStarProjection.mem_iff he N′, commutant_commutant]

/-! ### The central support -/

/-- The **central support** (central carrier) of an operator `e` in a von Neumann algebra `N`: the
orthogonal projection onto the closed subspace generated by the vectors `a (e x)` with `a ∈ N`. It
lies in `N′` and satisfies `P e = e`; for `e ∈ N` it is a central projection of `N`
(`isCentralProjection_centralSupport`), the least one with `P e = e`
(`IsCentralProjection.mul_centralSupport`). Neither `e` nor the operators it is tested against
need be projections. -/
noncomputable def centralSupport (N : VonNeumannAlgebra H) (e : H →L[ℂ] H) : H →L[ℂ] H :=
  (Submodule.span ℂ {y | ∃ a ∈ N, ∃ x, (a : H →L[ℂ] H) (e x) = y}).topologicalClosure.starProjection

/-- The central support is a star projection. -/
lemma isStarProjection_centralSupport (N : VonNeumannAlgebra H) (e : H →L[ℂ] H) :
    IsStarProjection (centralSupport N e) :=
  isStarProjection_starProjection

/-- The central support of `e` fixes every vector `a (e x)` with `a ∈ N`. -/
lemma centralSupport_apply_apply {N : VonNeumannAlgebra H} (e : H →L[ℂ] H) {a : H →L[ℂ] H}
    (ha : a ∈ N) (x : H) : centralSupport N e (a (e x)) = a (e x) :=
  Submodule.starProjection_eq_self_iff.mpr
    (Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨a, ha, x, rfl⟩))

/-- The central support of `e` carries `e`: `P e = e`. -/
lemma centralSupport_mul_self (N : VonNeumannAlgebra H) (e : H →L[ℂ] H) :
    centralSupport N e * e = e := by
  ext x
  exact centralSupport_apply_apply e (one_mem N) x

private lemma apply_apply_mem_range_centralSupport {N : VonNeumannAlgebra H} (e : H →L[ℂ] H)
    {a : H →L[ℂ] H} (ha : a ∈ N) (x : H) : a (e x) ∈ (centralSupport N e).range :=
  ⟨a (e x), centralSupport_apply_apply e ha x⟩

/-- An operator that maps the generating vectors `a (e x)` into the range of the central support
leaves that range invariant. -/
private lemma range_centralSupport_mem_invtSubmodule {N : VonNeumannAlgebra H} {e y : H →L[ℂ] H}
    (hy : ∀ a ∈ N, ∀ x, y (a (e x)) ∈ (centralSupport N e).range) :
    (centralSupport N e).range ∈ Module.End.invtSubmodule (y : Module.End ℂ H) := by
  simp only [centralSupport, Submodule.range_starProjection] at hy ⊢
  set S : Set H := {y | ∃ a ∈ N, ∃ x, (a : H →L[ℂ] H) (e x) = y}
  set M : Submodule ℂ H := (Submodule.span ℂ S).topologicalClosure
  have hclosed : IsClosed ((M.comap (y : H →ₗ[ℂ] H)) : Set H) := by
    rw [Submodule.comap_coe]
    exact ((Submodule.span ℂ S).isClosed_topologicalClosure).preimage y.continuous
  have hle : M ≤ M.comap (y : H →ₗ[ℂ] H) := by
    apply Submodule.topologicalClosure_minimal (Submodule.span ℂ S) _ hclosed
    rw [Submodule.span_le]
    rintro s ⟨a, ha, x, rfl⟩
    exact hy a ha x
  exact hle

/-- The central support of any operator lies in the commutant `N′`: its range is invariant under
`N`. -/
lemma centralSupport_mem_commutant (N : VonNeumannAlgebra H) (e : H →L[ℂ] H) :
    centralSupport N e ∈ N′ := by
  rw [IsStarProjection.mem_commutant_iff (isStarProjection_centralSupport N e)]
  intro y hy
  exact range_centralSupport_mem_invtSubmodule fun a ha x =>
    apply_apply_mem_range_centralSupport e (mul_mem hy ha) x

/-- The central support of an operator of `N` lies in `N`: its range is invariant under `N′`. -/
lemma centralSupport_mem {N : VonNeumannAlgebra H} {e : H →L[ℂ] H} (he : e ∈ N) :
    centralSupport N e ∈ N := by
  rw [IsStarProjection.mem_iff (isStarProjection_centralSupport N e) N]
  intro y hy
  refine range_centralSupport_mem_invtSubmodule fun a ha x => ?_
  have hay : a * y = y * a := mem_commutant_iff.mp hy a ha
  have hey : e * y = y * e := mem_commutant_iff.mp hy e he
  have heq : y (a (e x)) = a (e (y x)) := by
    rw [show y (a (e x)) = (y * a) (e x) from rfl, ← hay,
      show (a * y) (e x) = a ((y * e) x) from rfl, ← hey]
    rfl
  rw [heq]
  exact apply_apply_mem_range_centralSupport e ha (y x)

/-- **The central support of an operator of `N` is a central projection of `N`.** -/
theorem isCentralProjection_centralSupport {N : VonNeumannAlgebra H} {e : H →L[ℂ] H}
    (he : e ∈ N) : IsCentralProjection N (centralSupport N e) :=
  ⟨isStarProjection_centralSupport N e,
    mem_center_iff.mpr ⟨centralSupport_mem he, centralSupport_mem_commutant N e⟩⟩

/-- **The central support detects `q N e = 0`**: an operator `q` annihilates the central support
of `e` exactly when `q a e = 0` for every `a ∈ N`. -/
theorem mul_centralSupport_eq_zero_iff {N : VonNeumannAlgebra H} {e q : H →L[ℂ] H} :
    q * centralSupport N e = 0 ↔ ∀ a ∈ N, q * a * e = 0 := by
  refine ⟨fun hq a ha => ?_, fun hq => ?_⟩
  · ext x
    rw [show (q * a * e) x = q (a (e x)) from rfl, ← centralSupport_apply_apply e ha x,
      show q (centralSupport N e (a (e x))) = (q * centralSupport N e) (a (e x)) from rfl, hq]
    rfl
  · have hker : (centralSupport N e).range ≤ LinearMap.ker (q : H →ₗ[ℂ] H) := by
      simp only [centralSupport, Submodule.range_starProjection]
      apply Submodule.topologicalClosure_minimal _ _ q.isClosed_ker
      rw [Submodule.span_le]
      rintro s ⟨a, ha, x, rfl⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker, ContinuousLinearMap.coe_coe]
      rw [show q (a (e x)) = (q * a * e) x from rfl, hq a ha]
      rfl
    ext x
    have hx : centralSupport N e x ∈ LinearMap.ker (q : H →ₗ[ℂ] H) := hker ⟨x, rfl⟩
    simpa using hx

/-- **The central support is the least central projection carrying `e`**: a central projection
`z` of `N` with `z e = e` dominates the central support of `e`, `z P = P`. -/
theorem IsCentralProjection.mul_centralSupport {N : VonNeumannAlgebra H} {e z : H →L[ℂ] H}
    (hz : IsCentralProjection N z) (hze : z * e = e) :
    z * centralSupport N e = centralSupport N e := by
  have h : (1 - z) * centralSupport N e = 0 :=
    mul_centralSupport_eq_zero_iff.mpr fun a ha => by
      have hza : a * z = z * a := mem_commutant_iff.mp hz.mem_commutant a ha
      rw [sub_mul, one_mul, sub_mul, ← hza, mul_assoc a z e, hze, sub_self]
  rw [sub_mul, one_mul, sub_eq_zero] at h
  exact h.symm

/-- **Central support (factor case).** In a factor, `q N e ≠ 0` for a nonzero operator `q` and a
nonzero `e ∈ N`: there is `a ∈ N` with `q a e ≠ 0`. The statement needs no projection hypothesis
on `e` or `q`, only `e ∈ N`, `e ≠ 0` and `q ≠ 0`. The central support `P` of `e` is a central
projection, hence `0` or `1` in a factor; `P e = e ≠ 0` excludes `0`, so `P = 1`, and `q P = 0`
would give `q = 0`. This is the geometric input of the comparison theorem. -/
lemma exists_mul_mul_ne_zero_of_isCentral {N : VonNeumannAlgebra H} [Algebra.IsCentral ℂ N]
    {e q : H →L[ℂ] H} (heN : e ∈ N) (he0 : e ≠ 0) (hq0 : q ≠ 0) : ∃ a ∈ N, q * a * e ≠ 0 := by
  by_contra hcon
  have hqP : q * centralSupport N e = 0 := mul_centralSupport_eq_zero_iff.mpr fun a haN => by
    by_contra h; exact hcon ⟨a, haN, h⟩
  rcases (isCentralProjection_centralSupport heN).eq_zero_or_eq_one with h0 | h1
  · exact he0 (by rw [← centralSupport_mul_self N e, h0, zero_mul])
  · exact hq0 (by rw [← mul_one q, ← h1, hqP])

/-! ### Invariance under spatial isomorphisms -/

section Conj

variable {H' : Type*} [NormedAddCommGroup H'] [InnerProductSpace ℂ H'] [CompleteSpace H']

/-- **Factors are spatially invariant**: if `N` is a factor, so is `U N U⋆`, since `conjEquiv U N`
is a `⋆`-isomorphism `N ≃⋆ₐ U N U⋆`. -/
instance isCentral_conj {N : VonNeumannAlgebra H} [Algebra.IsCentral ℂ N] (U : H ≃ₗᵢ[ℂ] H') :
    Algebra.IsCentral ℂ (conj U N) :=
  .of_algEquiv' (conjEquiv U N).toAlgEquiv

/-- `U N U⋆` is a factor iff `N` is. -/
lemma isCentral_conj_iff {N : VonNeumannAlgebra H} (U : H ≃ₗᵢ[ℂ] H') :
    Algebra.IsCentral ℂ (conj U N) ↔ Algebra.IsCentral ℂ N :=
  (Algebra.IsCentral.iff_of_algEquiv (conjEquiv U N).toAlgEquiv).symm

end Conj

end VonNeumannAlgebra
