/-!
# Strongly continuous unitary representations and Fourier transforms of projection-valued measures

A **strongly continuous unitary representation** of a monoid `G` with a topology on a Hilbert space
`H` is a continuous homomorphism `G →ₜ* UnitarySOT ℂ H` into the unitary group with the strong
operator topology (`UnitaryRepresentation G H`): `g ↦ U g y` is continuous for every vector `y`
(`UnitaryRepresentation.continuous_apply`).

A strongly continuous unitary representation of an additive group `V`, such as `ℝ` for a
one-parameter unitary group, is a continuous additive character `ContinuousAddChar V (UnitarySOT ℂ H)`
(`UnitaryAddRepresentation V H`): `U v` is the unitary at `v : V` and `U (v + w) = U v * U w`
(`map_add_eq_mul`). It is a strongly continuous unitary representation of `Multiplicative V` through
`ContinuousAddChar.toContinuousMonoidHom`. An additive character `U` into `unitary (H →L[ℂ] H)` such
that `v ↦ U v y` is continuous for every `y` is bundled by `UnitaryAddRepresentation.ofContinuous`.

For a bilinear pairing `L : W × V → ℝ` measurable in `w`, the **Fourier transform** of a
projection-valued measure on `W` is the unitary representation `v ↦ ∫ exp (i L(w, v)) dE(w)` of `V`
(`ProjectionValuedMeasure.fourier`), an additive character `AddChar V (UnitarySOT ℂ H)` on which no
continuity is imposed. If `V` carries a first-countable topology and the pairing is continuous in
`v`, it is strongly continuous (`ProjectionValuedMeasure.continuous_fourier`,
`ProjectionValuedMeasure.fourierRepresentation`). For `W = ℝ` and the multiplication it is the
unitary group generated by a self-adjoint operator, and for `W` the dual of `V` it is the form of a
unitary representation given by the SNAG theorem.

## Main definitions

* `UnitaryRepresentation G H` — the strongly continuous unitary representations of `G` on `H`.
* `UnitaryAddRepresentation V H` — the strongly continuous unitary representations of an additive
  group `V` on `H`, the continuous additive characters `ContinuousAddChar V (UnitarySOT ℂ H)`.
* `UnitaryAddRepresentation.ofContinuous U hU` — an additive character into `unitary (H →L[ℂ] H)`
  with `v ↦ U v y` continuous for every `y`, as a strongly continuous unitary representation.
* `ProjectionValuedMeasure.fourier E L hL` — the unitary representation
  `v ↦ ∫ exp (i L(w, v)) dE(w)`, an additive character `AddChar V (UnitarySOT ℂ H)`.
* `ProjectionValuedMeasure.fourierRepresentation E L hL hLc` — the same as a strongly continuous
  unitary representation of `V`, for a pairing continuous in `v`.

## Main results

* `UnitaryRepresentation.continuous_apply`, `UnitaryRepresentation.continuous_inner_apply` — the
  orbits `g ↦ U g y` and the matrix coefficients `g ↦ ⟪x, U g y⟫` are continuous.
* `ProjectionValuedMeasure.inner_fourier_apply_self` — `⟪y, U(v) y⟫ = ∫ exp (i L(w, v)) dE_y(w)`.
* `ProjectionValuedMeasure.continuous_fourier_apply`,
  `ProjectionValuedMeasure.continuous_fourier` — the Fourier transform is strongly continuous when
  `V` is first countable and the pairing is continuous in `v`.

## References

* [W. Rudin, *Functional Analysis*][rudin1991], §12.17–12.21
-/

@[expose] public section

open Set Filter Topology ContinuousLinearMap MeasureTheory
open scoped ENNReal InnerProductSpace ComplexConjugate

/-! ### Strongly continuous unitary representations -/

/-- A **strongly continuous unitary representation** on `H` of a monoid `G` carrying a topology: a
continuous homomorphism into the unitary group with the strong operator topology. No compatibility
of the topology of `G` with its multiplication is required. An additive group `V` is represented by a
`UnitaryAddRepresentation V H`. -/
abbrev UnitaryRepresentation (G H : Type*) [Monoid G] [TopologicalSpace G] [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] [CompleteSpace H] : Type _ :=
  G →ₜ* UnitarySOT ℂ H

/-- A **strongly continuous unitary representation** on `H` of an additive monoid `V` carrying a
topology: a continuous additive character into the unitary group with the strong operator topology,
so that `U v` is the unitary at `v : V` and `U (v + w) = U v * U w`. No compatibility of the topology
of `V` with its addition is required. -/
abbrev UnitaryAddRepresentation (V H : Type*) [AddMonoid V] [TopologicalSpace V]
    [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H] : Type _ :=
  ContinuousAddChar V (UnitarySOT ℂ H)

namespace UnitaryRepresentation

variable {X H F : Type*} [TopologicalSpace X] [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [FunLike F X (UnitarySOT ℂ H)] [ContinuousMapClass F X (UnitarySOT ℂ H)]

/-- The orbit `g ↦ U g y` of a vector under a strongly continuous unitary representation `U`, of a
monoid or of an additive monoid, is continuous. -/
lemma continuous_apply (U : F) (y : H) : Continuous fun g => U g y :=
  UnitarySOT.continuous_iff.mp (map_continuous U) y

/-- The matrix coefficients `g ↦ ⟪x, U g y⟫` of a strongly continuous unitary representation `U`, of
a monoid or of an additive monoid, are continuous. -/
lemma continuous_inner_apply (U : F) (x y : H) : Continuous fun g => ⟪x, U g y⟫_ℂ :=
  continuous_const.inner (continuous_apply U y)

end UnitaryRepresentation

namespace UnitaryAddRepresentation

variable {V H : Type*} [AddMonoid V] [TopologicalSpace V] [NormedAddCommGroup H]
  [InnerProductSpace ℂ H] [CompleteSpace H]

/-- An additive character into `unitary (H →L[ℂ] H)` such that `v ↦ U v y` is continuous for every
vector `y`, as a strongly continuous unitary representation. -/
noncomputable def ofContinuous (U : AddChar V (unitary (H →L[ℂ] H)))
    (hU : ∀ y, Continuous fun v => (U v : H →L[ℂ] H) y) : UnitaryAddRepresentation V H :=
  ⟨(UnitarySOT.ofUnitary ℂ H).toMonoidHom.compAddChar U, UnitarySOT.continuous_iff.mpr hU⟩

/-- The unitaries of `ofContinuous U hU` are those of `U`. -/
@[simp] lemma coe_ofContinuous_apply (U : AddChar V (unitary (H →L[ℂ] H)))
    (hU : ∀ y, Continuous fun v => (U v : H →L[ℂ] H) y) (v : V) :
    (ofContinuous U hU v : H →L[ℂ] H) = U v :=
  rfl

end UnitaryAddRepresentation

namespace MeasureTheory.ProjectionValuedMeasure

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Fourier transforms of projection-valued measures -/

section Fourier

variable {V W : Type*} [AddCommGroup V] [Module ℝ V] [AddCommGroup W] [Module ℝ W]
  [MeasurableSpace W] (E : ProjectionValuedMeasure W H) (L : W →ₗ[ℝ] V →ₗ[ℝ] ℝ)
  (hL : ∀ v, Measurable fun w => L w v)

include hL in
/-- The phase `w ↦ exp (i L(w, v))` of a pairing measurable in `w` is measurable. -/
lemma measurable_exp_pairing (v : V) :
    Measurable fun w => Complex.exp (L w v * Complex.I) :=
  ((Complex.measurable_ofReal.comp (hL v)).mul_const _).cexp

include hL in
/-- The spectral integral `∫ exp (i L(w, v)) dE(w)` of the phases is unitary. -/
lemma integral_exp_pairing_mem_unitary (v : V) :
    E.integral (fun w => Complex.exp (L w v * Complex.I)) ∈ unitary (H →L[ℂ] H) :=
  E.integral_mem_unitary (measurable_exp_pairing L hL v) fun _ => Complex.norm_exp_ofReal_mul_I _

include hL in
/-- The spectral integrals `∫ exp (i L(w, v)) dE(w)` multiply as the phases do:
`U(v + v') = U(v) U(v')`. -/
lemma integral_exp_pairing_add (v v' : V) :
    E.integral (fun w => Complex.exp (L w (v + v') * Complex.I)) =
      E.integral (fun w => Complex.exp (L w v * Complex.I)) *
        E.integral (fun w => Complex.exp (L w v' * Complex.I)) := by
  have h : (fun w => Complex.exp (L w (v + v') * Complex.I)) =
      (fun w => Complex.exp (L w v * Complex.I)) * fun w => Complex.exp (L w v' * Complex.I) := by
    ext w
    simp [add_mul, Complex.exp_add]
  rw [h, E.integral_mul (measurable_exp_pairing L hL v)
    ⟨1, fun _ => (Complex.norm_exp_ofReal_mul_I _).le⟩ (measurable_exp_pairing L hL v')
    ⟨1, fun _ => (Complex.norm_exp_ofReal_mul_I _).le⟩]

/-- The **Fourier transform** of a projection-valued measure `E` on `W` along a bilinear pairing
`L : W × V → ℝ` measurable in `w`: the unitary representation `v ↦ ∫ exp (i L(w, v)) dE(w)` of `V`,
an additive character into the unitary group, on which no continuity in `v` is imposed (`V` carries no
topology). It is strongly continuous when the pairing is continuous in `v`
(`continuous_fourier`, `fourierRepresentation`). For `W = ℝ` and `L` the multiplication it is the
unitary group `t ↦ exp (i t A)` of the self-adjoint operator `A` with projection-valued measure `E`;
for `W` the dual of `V` and `L` the evaluation pairing it is the representation whose
projection-valued measure the SNAG theorem recovers. -/
noncomputable def fourier : AddChar V (UnitarySOT ℂ H) :=
  (UnitarySOT.ofUnitary ℂ H).toMonoidHom.compAddChar
    { toFun v := ⟨E.integral fun w => Complex.exp (L w v * Complex.I),
        E.integral_exp_pairing_mem_unitary L hL v⟩
      map_zero_eq_one' := by
        ext1
        simp
      map_add_eq_mul' v v' := by
        ext1
        exact E.integral_exp_pairing_add L hL v v' }

/-- The Fourier transform of `E` is the spectral integral of the phases `exp (i L(·, v))`. -/
lemma coe_fourier_apply (v : V) :
    (E.fourier L hL v : H →L[ℂ] H) = E.integral fun w => Complex.exp (L w v * Complex.I) :=
  rfl

/-- `⟪y, U(v) y⟫ = ∫ exp (i L(w, v)) dE_y(w)`: the diagonal matrix elements of the Fourier
transform are the Fourier transforms of the diagonal measures. -/
lemma inner_fourier_apply_self (v : V) (y : H) :
    ⟪y, (E.fourier L hL v : H →L[ℂ] H) y⟫_ℂ =
      ∫ w, Complex.exp (L w v * Complex.I) ∂(E.measure y) :=
  E.inner_integral_self (measurable_exp_pairing L hL v)
    ⟨1, fun _ => (Complex.norm_exp_ofReal_mul_I _).le⟩ y

variable [TopologicalSpace V] [FirstCountableTopology V]

/-- **Strong continuity**: if `V` is first countable and `L(w, ·)` is continuous for every `w`, then
`v ↦ U(v) y` is continuous for every `y`. -/
lemma continuous_fourier_apply (hLc : ∀ w, Continuous fun v => L w v) (y : H) :
    Continuous fun v => (E.fourier L hL v : H →L[ℂ] H) y := by
  change Continuous fun v => E.integral (fun w => Complex.exp (L w v * Complex.I)) y
  set e : V → W → ℂ := fun v w => Complex.exp (L w v * Complex.I)
  have hb : ∀ v, ∃ C, ∀ w, ‖e v w‖ ≤ C := fun v => ⟨1, fun _ => (Complex.norm_exp_ofReal_mul_I _).le⟩
  refine continuous_iff_continuousAt.mpr fun v₀ => ?_
  rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
  have hsq : ∀ v, ‖E.integral (e v) y - E.integral (e v₀) y‖ =
      √(∫ w, ‖e v w - e v₀ w‖ ^ 2 ∂(E.measure y)) := fun v => by
    rw [← sub_apply,
      ← E.integral_sub (measurable_exp_pairing L hL v) (hb v) (measurable_exp_pairing L hL v₀)
        (hb v₀), ← Real.sqrt_sq (norm_nonneg _),
      E.norm_integral_apply_sq ((measurable_exp_pairing L hL v).sub (measurable_exp_pairing L hL v₀))
        ⟨2, fun w => (norm_sub_le _ _).trans (by
          rw [Complex.norm_exp_ofReal_mul_I, Complex.norm_exp_ofReal_mul_I]; norm_num)⟩]
    rfl
  have hc : Continuous fun v => ∫ w, ‖e v w - e v₀ w‖ ^ 2 ∂(E.measure y) := by
    refine continuous_of_dominated (bound := fun _ => 4)
      (fun v => (((measurable_exp_pairing L hL v).sub
        (measurable_exp_pairing L hL v₀)).norm.pow_const 2).aestronglyMeasurable)
      (fun v => Eventually.of_forall fun w => ?_) (integrable_const _)
      (Eventually.of_forall fun w => ?_)
    · rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), show (4 : ℝ) = 2 ^ 2 by norm_num]
      refine pow_le_pow_left₀ (norm_nonneg _) ((norm_sub_le _ _).trans ?_) 2
      simp only [e, Complex.norm_exp_ofReal_mul_I]
      norm_num
    · have := hLc w
      fun_prop
  change Tendsto (fun v => ‖E.integral (e v) y - E.integral (e v₀) y‖) (𝓝 v₀) (𝓝 0)
  simp_rw [hsq]
  have h0 : ((fun x => √x) ∘ fun v => ∫ w, ‖e v w - e v₀ w‖ ^ 2 ∂(E.measure y)) v₀ = 0 := by
    simp
  rw [← h0]
  exact (Real.continuous_sqrt.comp hc).tendsto v₀

/-- **Strong continuity**: if `V` is first countable and `L(w, ·)` is continuous for every `w`, the
Fourier transform `v ↦ ∫ exp (i L(w, v)) dE(w)` is continuous into the unitary group with the strong
operator topology. -/
lemma continuous_fourier (hLc : ∀ w, Continuous fun v => L w v) : Continuous (E.fourier L hL) :=
  UnitarySOT.continuous_iff.mpr fun y => E.continuous_fourier_apply L hL hLc y

/-- The Fourier transform of `E` along a pairing continuous in `v`, for a first-countable topology
on `V`, as a strongly continuous unitary representation of `V`. -/
noncomputable def fourierRepresentation (hLc : ∀ w, Continuous fun v => L w v) :
    UnitaryAddRepresentation V H :=
  ⟨E.fourier L hL, E.continuous_fourier L hL hLc⟩

/-- The unitaries of `fourierRepresentation` are those of `fourier`. -/
@[simp] lemma fourierRepresentation_apply (hLc : ∀ w, Continuous fun v => L w v)
    (v : V) : E.fourierRepresentation L hL hLc v = E.fourier L hL v :=
  rfl

end Fourier

end MeasureTheory.ProjectionValuedMeasure
